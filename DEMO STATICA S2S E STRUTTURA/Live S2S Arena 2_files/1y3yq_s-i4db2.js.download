(globalThis.TURBOPACK||(globalThis.TURBOPACK=[])).push(["object"==typeof document?document.currentScript:void 0,120577,e=>{"use strict";let t={explain_recipe:{id:"explain_recipe",group:"knowledge_teaching",title:"Explain a Recipe",description:"Share a recipe you actually cook.",hint:"Show the steps with your hands."},teach_phrase:{id:"teach_phrase",group:"knowledge_teaching",title:"Teach a Phrase",description:"Teach the caller a few phrases in another language you know, or slang from your region.",hint:"Be patient and repeat as needed."},explain_concept:{id:"explain_concept",group:"knowledge_teaching",title:"Explain a Concept",description:"Pick any concept you understand well (science, art, finance, sport rules) and explain it simply.",hint:"Use analogies from everyday life."},teach_game:{id:"teach_game",group:"knowledge_teaching",title:"Teach a Game",description:"Explain a game you enjoy — cards, board game, sport, video game.",hint:"Walk through the rules step by step."},share_life_hacks:{id:"share_life_hacks",group:"knowledge_teaching",title:"Share Life Hacks",description:"Share practical tips or tricks you've learned — anything from household to work to tech.",hint:"Demonstrate where possible."},explain_your_job:{id:"explain_your_job",group:"knowledge_teaching",title:"Explain Your Job",description:"Describe your work to someone who knows nothing about it.",hint:"Use analogies from everyday life."},teach_exercise:{id:"teach_exercise",group:"knowledge_teaching",title:"Teach an Exercise",description:"Show the caller a physical exercise or stretch you know.",hint:"Demonstrate proper form."},tell_history:{id:"tell_history",group:"knowledge_teaching",title:"Tell a History",description:"Share a historical event, cultural tradition, or family history you find interesting.",hint:"Make it vivid and personal."},teach_craft:{id:"teach_craft",group:"knowledge_teaching",title:"Teach a Craft",description:"Show how to make or fold something — origami, a braid, a knot, anything hands-on.",hint:"Go step by step slowly."},explain_how_works:{id:"explain_how_works",group:"knowledge_teaching",title:"Explain How Something Works",description:"Pick any device, system, or process and explain the mechanism behind it.",hint:"Use gestures to illustrate."},recommend_book_show:{id:"recommend_book_show",group:"knowledge_teaching",title:"Recommend a Book/Show",description:"Share something you've read or watched.",hint:"Summarize it, say why you liked it, sell it to the caller."},teach_practical_skill:{id:"teach_practical_skill",group:"knowledge_teaching",title:"Teach a Practical Skill",description:"First aid, changing a tire, sewing a button — pick a useful skill and walk through it.",hint:"Demonstrate each step."},explain_with_numbers:{id:"explain_with_numbers",group:"knowledge_teaching",title:"Explain with Numbers",description:"Explain a concept that involves numbers or math.",hint:"Use objects or your fingers to illustrate."},teach_move:{id:"teach_move",group:"knowledge_teaching",title:"Teach a Move",description:"Teach a dance move, a martial arts stance, a yoga pose — any physical technique you know.",hint:"Break it down slowly."},describe_place:{id:"describe_place",group:"knowledge_teaching",title:"Describe a Place",description:"Talk about a place you know well — a city, a neighborhood, a country.",hint:"Share what makes it special."},would_you_rather:{id:"would_you_rather",group:"question_answering",title:"Would You Rather",description:'Play "would you rather" — answer genuinely and explain your reasoning.',hint:"Think through your choices out loud."},friendly_debate:{id:"friendly_debate",group:"question_answering",title:"Friendly Debate",description:"Pick a lighthearted topic you have an opinion on and debate it with the caller.",hint:"Defend your position with humor."},twenty_questions:{id:"twenty_questions",group:"question_answering",title:"20 Questions",description:"Think of something. Let the caller ask yes/no questions to guess it.",hint:"Be expressive with your answers."},trivia:{id:"trivia",group:"question_answering",title:"Trivia",description:"Answer trivia questions from the caller.",hint:"Think out loud when you're unsure."},two_truths_lie:{id:"two_truths_lie",group:"question_answering",title:"Two Truths and a Lie",description:"Share two true things and one lie about yourself.",hint:"Be convincing on all three."},this_or_that:{id:"this_or_that",group:"question_answering",title:"This or That",description:"Rapid-fire choices from the caller.",hint:"Answer quickly and honestly."},hot_takes:{id:"hot_takes",group:"question_answering",title:"Hot Takes",description:"Share your honest opinion on whatever the caller brings up.",hint:"Don't hold back."},talk_favorites:{id:"talk_favorites",group:"question_answering",title:"Talk About Your Favorites",description:"Share your favorite things when the caller asks — movie, food, memory, place, song.",hint:"Be specific and passionate."},brainstorm_together:{id:"brainstorm_together",group:"question_answering",title:"Brainstorm Together",description:"The caller poses a hypothetical problem.",hint:"Think it through together out loud."},guess_the_word:{id:"guess_the_word",group:"question_answering",title:"Guess the Word",description:"The caller describes something without naming it. Try to guess.",hint:"Think aloud and ask clarifying questions."},rate_things:{id:"rate_things",group:"question_answering",title:"Rate Things",description:"The caller presents items or ideas. Rate them, explain your scores.",hint:"Disagree if you want."},debate_hypothetical:{id:"debate_hypothetical",group:"question_answering",title:"Debate a Hypothetical",description:'The caller poses a "what if" scenario. Take a position and argue it out.',hint:"Change your mind if they convince you."},make_something:{id:"make_something",group:"demonstrations",title:"Make Something",description:"Prepare food, a drink, a craft — whatever you have around.",hint:"Talk through it as you go."},unbox_show_new:{id:"unbox_show_new",group:"demonstrations",title:"Unbox / Show Something New",description:"Open a package or show something you recently got.",hint:"Share your genuine reaction."},tour_your_space:{id:"tour_your_space",group:"demonstrations",title:"Tour Your Space",description:"Show the caller your desk, room, or workspace.",hint:"Pick up items and tell their stories."},draw_or_write:{id:"draw_or_write",group:"demonstrations",title:"Draw or Write",description:"Sketch, doodle, or write something while talking.",hint:"Show your progress to the camera."},fix_set_up:{id:"fix_set_up",group:"demonstrations",title:"Fix or Set Up Something",description:"Troubleshoot a device, fix a small thing, or set something up.",hint:"Talk through the process."},wrap_package:{id:"wrap_package",group:"demonstrations",title:"Wrap or Package",description:"Wrap a gift, pack a box, or fold something.",hint:"Talk while your hands are busy."},care_for_something:{id:"care_for_something",group:"demonstrations",title:"Care for Something",description:"Water a plant, organize a shelf, clean an item — tend to something while chatting.",hint:"Let the task be secondary to conversation."},show_off_items:{id:"show_off_items",group:"demonstrations",title:"Show Off Clothes/Items",description:"Show the caller items from your closet, collection, or shelf.",hint:"Get their opinion."},taste_and_react:{id:"taste_and_react",group:"demonstrations",title:"Taste and React",description:"Try a food or drink and share your honest reaction.",hint:"Describe the taste in detail."},demonstrate_tool:{id:"demonstrate_tool",group:"demonstrations",title:"Demonstrate a Tool",description:"Show how to use a tool, gadget, or appliance you have.",hint:"Explain as you go."},grooming_self_care:{id:"grooming_self_care",group:"demonstrations",title:"Grooming/Self-Care",description:"Do a simple self-care step (moisturize, style hair, file nails) while having a conversation.",hint:"Be natural and relaxed."},pack_for_something:{id:"pack_for_something",group:"demonstrations",title:"Pack for Something",description:"Pack a bag, lunchbox, or kit for an upcoming activity.",hint:"Choose items and explain your picks."},tell_spooky_story:{id:"tell_spooky_story",group:"storytelling_performance",title:"Tell a Spooky Story",description:"Tell a scary or mysterious story — real or made up.",hint:"Build tension your own way."},be_news_anchor:{id:"be_news_anchor",group:"storytelling_performance",title:"Be a News Anchor",description:'Deliver "news" — real, fake, or absurd.',hint:"Be dramatic. React to interruptions."},do_comedy:{id:"do_comedy",group:"storytelling_performance",title:"Do Comedy",description:"Tell jokes, share funny stories, or do physical comedy.",hint:"Read the caller's reactions."},give_inspiring_speech:{id:"give_inspiring_speech",group:"storytelling_performance",title:"Give an Inspiring Speech",description:"Speak about something that motivates you.",hint:"Be genuine. Move if you feel it."},commentate:{id:"commentate",group:"storytelling_performance",title:"Commentate",description:"Narrate something happening (a sport, the view, an activity) like a live commentator.",hint:"Be energetic and detailed."},tell_story_for_kid:{id:"tell_story_for_kid",group:"storytelling_performance",title:"Tell a Story for a Kid",description:"Tell a children's story with character voices and animated expressions.",hint:"Be playful and expressive."},be_musical:{id:"be_musical",group:"storytelling_performance",title:"Be Musical",description:"Rap, sing, beatbox, hum, or perform musically in whatever way is natural for you.",hint:"Commit to it fully."},do_a_trick:{id:"do_a_trick",group:"storytelling_performance",title:"Do a Trick",description:"Perform a magic trick, a card trick, a skill trick — anything that has a reveal.",hint:"Build up the suspense."},reenact_scene:{id:"reenact_scene",group:"storytelling_performance",title:"Reenact a Scene",description:"Act out a scene from a movie, show, or real life event.",hint:"Play all the parts."},do_impressions:{id:"do_impressions",group:"storytelling_performance",title:"Do Impressions",description:"Imitate people, characters, or accents.",hint:"Let the caller guess or request them."},interview_someone:{id:"interview_someone",group:"roleplay_social",title:"Interview Someone",description:"You're the interviewer. Ask real questions.",hint:"React to the answers."},be_interviewed:{id:"be_interviewed",group:"roleplay_social",title:"Be Interviewed",description:"You're being questioned.",hint:"Answer naturally — confident, nervous, or both."},handle_complaint:{id:"handle_complaint",group:"roleplay_social",title:"Handle a Complaint",description:"A customer/friend is unhappy.",hint:"Stay calm and work toward resolution."},be_doctor_advisor:{id:"be_doctor_advisor",group:"roleplay_social",title:"Be a Doctor/Advisor",description:'Give a lighthearted "consultation."',hint:"Ask questions, examine, advise."},sell_something:{id:"sell_something",group:"roleplay_social",title:"Sell Something",description:'Show a "property," product, or idea.',hint:"Convince the caller. Handle pushback."},serve_someone:{id:"serve_someone",group:"roleplay_social",title:"Serve Someone",description:"Take an order from the caller and mime preparing or delivering it — play the service role through the screen.",hint:"Act out each step."},give_safety_demo:{id:"give_safety_demo",group:"roleplay_social",title:"Give a Safety Demo",description:"Explain safety procedures for a specific context (flight, lab, kitchen).",hint:"Use gestures and props. Be professional but personable."},be_a_guide:{id:"be_a_guide",group:"roleplay_social",title:"Be a Guide",description:"Lead the caller through an imaginary place.",hint:"Share facts, answer questions, keep moving."},teach_a_class:{id:"teach_a_class",group:"roleplay_social",title:"Teach a Class",description:"Run a classroom moment.",hint:"Ask questions, give feedback, maintain energy."},negotiate:{id:"negotiate",group:"roleplay_social",title:"Negotiate",description:"Haggle, negotiate, or make a deal with the caller.",hint:"Read their body language."},apologize:{id:"apologize",group:"roleplay_social",title:"Apologize",description:"You messed up. Apologize sincerely.",hint:"React to how the caller takes it."},reveal_surprise:{id:"reveal_surprise",group:"roleplay_social",title:"Reveal a Surprise",description:"Build up to telling the caller something exciting.",hint:"Struggle to contain it."},charades:{id:"charades",group:"games_challenges",title:"Charades",description:"Act things out without words.",hint:"React to guesses. Celebrate when they get it."},simon_says:{id:"simon_says",group:"games_challenges",title:"Simon Says",description:"Lead the game.",hint:"Try to trick the caller. Have fun with it."},rock_paper_scissors:{id:"rock_paper_scissors",group:"games_challenges",title:"Rock Paper Scissors",description:"Play several rounds.",hint:"Be dramatic about wins and losses."},mirror_game:{id:"mirror_game",group:"games_challenges",title:"Mirror Game",description:"You move, the caller copies.",hint:"Start easy, make it harder. Laugh together."},truth_or_dare:{id:"truth_or_dare",group:"games_challenges",title:"Truth or Dare",description:"Take turns.",hint:"Actually commit to the dares. Be honest with truths."},name_that_tune:{id:"name_that_tune",group:"games_challenges",title:"Name That Tune",description:"Hum, tap, or whistle songs.",hint:"Give hints. Celebrate or groan at guesses."},word_association:{id:"word_association",group:"games_challenges",title:"Word Association",description:"Rapid-fire words back and forth.",hint:"React to unexpected ones."},accent_voice_challenge:{id:"accent_voice_challenge",group:"games_challenges",title:"Accent/Voice Challenge",description:"Try different accents or voices with the caller.",hint:"Judge each other."},compliment_battle:{id:"compliment_battle",group:"games_challenges",title:"Compliment Battle",description:"Trade creative compliments.",hint:"Try to out-do each other."},collaborative_story:{id:"collaborative_story",group:"games_challenges",title:"Collaborative Story",description:"Build a story together, one sentence each.",hint:"React to each other's twists."},receiving_bad_news:{id:"receiving_bad_news",group:"emotional_reactive",title:"Receiving Bad News",description:"The caller delivers bad news.",hint:"Let your emotions escalate naturally."},receiving_good_news:{id:"receiving_good_news",group:"emotional_reactive",title:"Receiving Good News",description:"The caller shares great news.",hint:"Let your excitement build."},awkward_encounter:{id:"awkward_encounter",group:"emotional_reactive",title:"Awkward Encounter",description:"You've run into someone from an awkward past.",hint:"Navigate the discomfort."},saying_goodbye:{id:"saying_goodbye",group:"emotional_reactive",title:"Saying Goodbye",description:"You're parting ways with the caller for a long time.",hint:"Let yourself feel it."},caught_in_lie:{id:"caught_in_lie",group:"emotional_reactive",title:"Caught in a Lie",description:"The caller catches you in a fib.",hint:"Work through denial to confession."},reunion:{id:"reunion",group:"emotional_reactive",title:"Reunion",description:"You're seeing the caller after a long time apart.",hint:"Let the emotion come naturally."},getting_scared:{id:"getting_scared",group:"emotional_reactive",title:"Getting Scared",description:"The caller tries to scare you.",hint:"React genuinely — startle, laugh, recover."},being_impressed:{id:"being_impressed",group:"emotional_reactive",title:"Being Impressed",description:"The caller shows you something amazing.",hint:"Let your admiration show."},consoling_someone:{id:"consoling_someone",group:"emotional_reactive",title:"Consoling Someone",description:"The caller is upset.",hint:"Comfort them in your own way."},celebrating_together:{id:"celebrating_together",group:"emotional_reactive",title:"Celebrating Together",description:"Something great just happened for both of you.",hint:"Celebrate however feels natural."},morning_routine:{id:"morning_routine",group:"daily_life",title:"Morning Routine",description:"Walk through your actual morning — what you do, in what order, your habits.",hint:"Be specific and genuine."},catching_up:{id:"catching_up",group:"daily_life",title:"Catching Up",description:"Chat with the caller like an old friend you haven't seen in a while.",hint:"Be warm and curious."},ordering_food:{id:"ordering_food",group:"daily_life",title:"Ordering Food",description:"Go through the process of picking and ordering food.",hint:"Change your mind. Deliberate."},giving_directions:{id:"giving_directions",group:"daily_life",title:"Giving Directions",description:"The caller is lost.",hint:"Help them get somewhere using gestures and descriptions."},pretend_phone_call:{id:"pretend_phone_call",group:"daily_life",title:"Pretend Phone Call",description:"Act as if you just received a phone call during the video call.",hint:"Mime picking up, have a one-sided conversation, react, then return to the caller."},joining_call_roleplay:{id:"joining_call_roleplay",group:"daily_life",title:"Joining a Call (Roleplay)",description:"Act out the moment of joining a video call for the first time.",hint:"Adjust camera, check audio, wave, settle in, react to seeing the caller. Treat it as a fresh entrance."},small_talk:{id:"small_talk",group:"daily_life",title:"Small Talk",description:"Make casual small talk with the caller in a waiting situation.",hint:"Fill the silence naturally."},shopping_together:{id:"shopping_together",group:"daily_life",title:"Shopping Together",description:"Browse items with the caller.",hint:"Discuss choices. Get their opinion."},task_in_parallel:{id:"task_in_parallel",group:"daily_life",title:"Doing a Task in Parallel",description:"Both you and the caller do a similar task in your own space (folding, organizing, cooking).",hint:"Coordinate, compare progress, and chat while working."},multitask_chat:{id:"multitask_chat",group:"daily_life",title:"Multitask and Chat",description:"Do a chore or task while having a casual conversation with the caller.",hint:"Let the task be background to the conversation."},give_presentation:{id:"give_presentation",group:"professional_instructional",title:"Give a Presentation",description:"Present an idea, a pitch, or a report.",hint:"Handle audience questions."},review_work:{id:"review_work",group:"professional_instructional",title:"Review Someone's Work",description:"Walk through reviewing something.",hint:"Give both praise and constructive feedback."},run_meeting:{id:"run_meeting",group:"professional_instructional",title:"Run a Meeting",description:"Facilitate a short meeting.",hint:"Keep things on track. Wrap up with action items."},authority_briefing:{id:"authority_briefing",group:"professional_instructional",title:"Authority Briefing",description:"Brief the caller as if they're a new employee, a student, or a visitor.",hint:"Cover rules, procedures, and expectations with authority."},demo_product:{id:"demo_product",group:"professional_instructional",title:"Demo a Product",description:"Show off a product or service.",hint:"Handle objections. Try to close."},yes_and_improv:{id:"yes_and_improv",group:"creative_improv",title:'"Yes, And" Improv',description:"Do improv with the caller. Accept everything and build on it.",hint:"Be physical."},describe_dream:{id:"describe_dream",group:"creative_improv",title:"Describe a Dream",description:"Describe a vivid dream — real or invented.",hint:"Act it out. Let it be weird."},fish_out_of_water:{id:"fish_out_of_water",group:"creative_improv",title:"Fish Out of Water",description:"You're in a place or time you don't belong.",hint:"React to everything with fresh eyes."},free_form:{id:"free_form",group:"creative_improv",title:"Free Form",description:"No topic assigned — just talk, interact, and let the conversation go wherever it goes naturally.",hint:"Be yourself."},share_fitness_routine:{id:"share_fitness_routine",group:"health_wellness",title:"Share Your Fitness Routine",description:"Describe how you stay active — gym, walks, sports, stretching.",hint:"Demo a move if you want."},talk_about_diet:{id:"talk_about_diet",group:"health_wellness",title:"Talk About Your Diet",description:"What you eat, why, guilty pleasures.",hint:"Share honest opinions about food and health."},guide_breathing_exercise:{id:"guide_breathing_exercise",group:"health_wellness",title:"Guide a Breathing Exercise",description:"Lead the caller through a breathing or mindfulness exercise.",hint:"Stay calm and present."},share_health_scare:{id:"share_health_scare",group:"health_wellness",title:"Share a Health Scare",description:"Tell about a time your health worried you.",hint:"How did you handle it? What did you learn?"},talk_about_sleep:{id:"talk_about_sleep",group:"health_wellness",title:"Talk About Sleep",description:"Your sleep habits, rituals, insomnia, dreams.",hint:"What helps, what doesn't."},describe_stress_relief:{id:"describe_stress_relief",group:"health_wellness",title:"Describe Your Stress Relief",description:"What do you do when overwhelmed? Walk, music, cooking, silence?",hint:"Show the caller."},share_personal_goal:{id:"share_personal_goal",group:"health_wellness",title:"Share a Personal Goal",description:"Something you're working toward right now.",hint:"Why it matters, how it's going."},reflect_on_mistake:{id:"reflect_on_mistake",group:"health_wellness",title:"Reflect on a Mistake",description:"Something you got wrong and what you learned.",hint:"Be honest, not rehearsed."},plan_dream_trip:{id:"plan_dream_trip",group:"travel_culture",title:"Plan a Dream Trip",description:"Plan an imaginary vacation with the caller.",hint:"Pick destinations, activities, food. Negotiate."},share_travel_disaster:{id:"share_travel_disaster",group:"travel_culture",title:"Share a Travel Disaster",description:"A trip that went horribly wrong.",hint:"Tell the story with all the drama and comedy."},explain_cultural_tradition:{id:"explain_cultural_tradition",group:"travel_culture",title:"Explain a Cultural Tradition",description:"A custom, ritual, or tradition from your background.",hint:"Explain why it matters."},compare_two_cultures:{id:"compare_two_cultures",group:"travel_culture",title:"Compare Two Cultures",description:"Discuss real differences you've noticed between cultures — food, greetings, values, humor.",hint:"Be specific and respectful."},share_culture_shock:{id:"share_culture_shock",group:"travel_culture",title:"Share a Culture Shock",description:"A time you were in an unfamiliar place and something genuinely surprised you.",hint:"Describe your reaction."},language_barrier_story:{id:"language_barrier_story",group:"travel_culture",title:"Tell a Language Barrier Story",description:"A time communication completely failed — funny, awkward, or stressful.",hint:"Reenact the confusion."},talk_food_culture:{id:"talk_food_culture",group:"travel_culture",title:"Talk About Food Culture",description:"Regional dishes, meal rituals, food rules.",hint:"What's normal to you that surprises others?"},describe_festival:{id:"describe_festival",group:"travel_culture",title:"Describe a Festival or Celebration",description:"A holiday or festival you love.",hint:"What happens, what it looks like, how it feels."},pitch_crazy_idea:{id:"pitch_crazy_idea",group:"opinions_values",title:"Pitch a Crazy Idea",description:"Propose something outlandish and try to convince the caller it would work.",hint:"Commit to it."},talk_about_money:{id:"talk_about_money",group:"opinions_values",title:"Talk About Money",description:"Your real relationship with money — spending, saving, guilt, freedom.",hint:"Be honest."},discuss_moral_dilemma:{id:"discuss_moral_dilemma",group:"opinions_values",title:"Discuss a Moral Dilemma",description:'Present a "no right answer" dilemma and think through it with the caller.',hint:"Explore both sides."},share_what_you_believe:{id:"share_what_you_believe",group:"opinions_values",title:"Share What You Believe",description:"A core belief or value you hold.",hint:"Explain why, how you got there, what tested it."},talk_about_future:{id:"talk_about_future",group:"opinions_values",title:"Talk About the Future",description:"Where you see yourself, your community, or the world going.",hint:"Hopes and fears."},talk_about_regret:{id:"talk_about_regret",group:"opinions_values",title:"Talk About a Regret",description:"Something you'd do differently if you could.",hint:"Not performative — genuinely reflective."},talk_about_art_music:{id:"talk_about_art_music",group:"opinions_values",title:"Talk About Art or Music",description:"A piece of art, song, or film that moved you.",hint:"Describe what it did to you and why."},tell_origin_story:{id:"tell_origin_story",group:"nostalgia_history",title:"Tell Your Origin Story",description:"How did you become who you are?",hint:"Key moments, decisions, accidents."},describe_childhood_memory:{id:"describe_childhood_memory",group:"nostalgia_history",title:"Describe a Childhood Memory",description:"One specific memory — not a summary of childhood, but one vivid scene.",hint:"Include sensory details."},talk_old_friend:{id:"talk_old_friend",group:"nostalgia_history",title:"Talk About an Old Friend",description:"Someone you were close to.",hint:"What made the friendship special? Where are they now?"},describe_first_job:{id:"describe_first_job",group:"nostalgia_history",title:"Describe Your First Job",description:"What it was, what you learned, the people you met.",hint:"The good and the bad."},talk_turning_point:{id:"talk_turning_point",group:"nostalgia_history",title:"Talk About a Turning Point",description:"A single moment or decision that changed the course of your life.",hint:"What led up to it, what followed."},revisit_old_hobby:{id:"revisit_old_hobby",group:"nostalgia_history",title:"Revisit an Old Hobby",description:"Something you used to love doing but stopped.",hint:"Why you started, why you stopped."},describe_who_shaped_you:{id:"describe_who_shaped_you",group:"nostalgia_history",title:"Describe Someone Who Shaped You",description:"A mentor, teacher, parent, or stranger who changed how you see the world.",hint:"What did they teach you?"},show_your_talent:{id:"show_your_talent",group:"talents_physical",title:"Show Your Talent",description:"Whatever you're good at — show it.",hint:"Build up, perform, take a bow."},teach_dance_routine:{id:"teach_dance_routine",group:"talents_physical",title:"Teach a Dance Routine",description:"Teach the caller a full dance sequence.",hint:"Count it out, demo each part, do it at full speed."},sing_tell_story:{id:"sing_tell_story",group:"talents_physical",title:"Sing and Tell the Story",description:"Sing a song that means something to you.",hint:"Before or after, tell why it matters."},lead_workout:{id:"lead_workout",group:"talents_physical",title:"Lead a Workout",description:"Run a real exercise routine.",hint:"Demo form, count reps, push the caller to keep up."},coach_sport_move:{id:"coach_sport_move",group:"talents_physical",title:"Coach a Sport Move",description:"Demonstrate a sports technique — a throw, kick, swing, stance.",hint:"Break down the mechanics."},model_outfit:{id:"model_outfit",group:"talents_physical",title:"Model an Outfit",description:"Walk, turn, pose.",hint:"Describe what you're wearing, why you chose it, how it makes you feel."},show_flexibility_balance:{id:"show_flexibility_balance",group:"talents_physical",title:"Show Flexibility or Balance",description:"Stretch, bend, hold poses.",hint:"Talk through each position and how you got there."},perform_spoken_word:{id:"perform_spoken_word",group:"talents_physical",title:"Perform Spoken Word",description:"Deliver a poem, monologue, rap, or memorized speech.",hint:"Use your whole presence — voice, face, body."},demonstrate_physical_skill:{id:"demonstrate_physical_skill",group:"talents_physical",title:"Demonstrate a Physical Skill",description:"Juggle, do a handstand, spin something, do a flip — any physical skill you've practiced.",hint:"Show the process."},move_to_music:{id:"move_to_music",group:"talents_physical",title:"Move to Music",description:"Put on music (real or imagined) and move to it.",hint:"Let rhythm guide your body. Explain what you feel."},breakup_scene:{id:"breakup_scene",group:"dramatic_scene_acting",title:"Breakup Scene",description:"You're ending a relationship. Go through the emotions — from resolve to doubt to final words.",hint:"The caller is the other person."},confrontation_friend:{id:"confrontation_friend",group:"dramatic_scene_acting",title:"Confrontation with a Friend",description:"A friend betrayed your trust. Confront them.",hint:"Start controlled, let it escalate, find (or don't find) resolution."},parent_child_argument:{id:"parent_child_argument",group:"dramatic_scene_acting",title:"Parent-Child Argument",description:"You're a parent (or child) in a heated family argument about life choices.",hint:"Show the love underneath the anger."},job_firing_scene:{id:"job_firing_scene",group:"dramatic_scene_acting",title:"Job Firing Scene",description:"You're being fired — or you're the one doing the firing.",hint:"Play the tension, the disbelief, the negotiation."},confession_scene:{id:"confession_scene",group:"dramatic_scene_acting",title:"Confession Scene",description:"You have a secret you've been hiding.",hint:"Build up to the confession. Let it out. Deal with the aftermath."},courtroom_testimony:{id:"courtroom_testimony",group:"dramatic_scene_acting",title:"Courtroom Testimony",description:"You're on the witness stand.",hint:"Deliver your testimony under pressure. React to objections and challenges."},hospital_video_call:{id:"hospital_video_call",group:"dramatic_scene_acting",title:"Hospital Video Call",description:"You're video-calling someone in the hospital (the caller).",hint:"Show the worry you're trying to hide through the screen. Ask how they're feeling, struggle to stay positive."},hostage_negotiation:{id:"hostage_negotiation",group:"dramatic_scene_acting",title:"Hostage Negotiation",description:"You're negotiating for someone's safety.",hint:"Stay calm under extreme pressure. Every word matters."},victory_speech:{id:"victory_speech",group:"dramatic_scene_acting",title:"Victory Speech",description:"You just won something life-changing.",hint:"Deliver a victory speech — emotional, grateful, overwhelmed."},eulogy_performance:{id:"eulogy_performance",group:"dramatic_scene_acting",title:"Eulogy Performance",description:"Deliver a eulogy for someone (fictional).",hint:"Balance grief, love, humor, and tribute. Let your voice break."},love_confession:{id:"love_confession",group:"dramatic_scene_acting",title:"Love Confession",description:"Tell someone (the caller) you're in love with them for the first time.",hint:"Nervous, sincere, vulnerable."},betrayal_discovery:{id:"betrayal_discovery",group:"dramatic_scene_acting",title:"Betrayal Discovery",description:"You just found out the caller has been lying to you about something important.",hint:"React in the moment — shock, anger, hurt, demanding answers. Focus on the initial explosion."},cop_interrogation:{id:"cop_interrogation",group:"dialogue_movie",title:"Cop Interrogation",description:"You're the detective interrogating a suspect (the caller).",hint:"Lean in, pace, change tactics — good cop, bad cop, your call."},war_buddy_farewell:{id:"war_buddy_farewell",group:"dialogue_movie",title:"War Buddy Farewell",description:"You and the caller are soldiers saying goodbye before a dangerous mission.",hint:"Keep it brave but let cracks show."},villain_monologue:{id:"villain_monologue",group:"dialogue_movie",title:"Villain Monologue",description:"You're the villain revealing your master plan.",hint:"Be theatrical, menacing, and enjoy every word."},romantic_comedy_meet_cute:{id:"romantic_comedy_meet_cute",group:"dialogue_movie",title:"Romantic Comedy Meet-Cute",description:"You and the caller just met in an awkward, charming way.",hint:"Fluster, charm, stumble over words."},action_hero_one_liner:{id:"action_hero_one_liner",group:"dialogue_movie",title:"Action Hero One-Liner",description:"You're an action hero.",hint:'Deliver dramatic one-liners, react to "explosions," be impossibly cool.'},period_drama_dialogue:{id:"period_drama_dialogue",group:"dialogue_movie",title:"Period Drama Dialogue",description:"Speak as if you're in a historical drama.",hint:"Formal language, restrained emotion, loaded subtext."},horror_movie_survivor:{id:"horror_movie_survivor",group:"dialogue_movie",title:"Horror Movie Survivor",description:"You're describing what happened to you.",hint:"Traumatized, shaking, reliving the terror. Build suspense."},comedy_duo_banter:{id:"comedy_duo_banter",group:"dialogue_movie",title:"Comedy Duo Banter",description:"You and the caller are a comedy team.",hint:"Riff off each other, set up punchlines, break each other up."},spy_debrief:{id:"spy_debrief",group:"dialogue_movie",title:"Spy Debrief",description:"You just returned from a mission. Report to your handler (the caller).",hint:"Tense, clipped, hiding something."},soap_opera_confrontation:{id:"soap_opera_confrontation",group:"dialogue_movie",title:"Soap Opera Confrontation",description:"Over-the-top dramatic confrontation.",hint:"Gasps, accusations, revelations. Turn every line up to 11."},last_video_call_separation:{id:"last_video_call_separation",group:"dialogue_movie",title:"Last Video Call Before Separation",description:"You're on a video call saying goodbye before a long separation.",hint:"The connection might drop any moment. Say everything that needs to be said before time runs out."},mentors_final_lesson:{id:"mentors_final_lesson",group:"dialogue_movie",title:"Mentor's Final Lesson",description:"You're the wise mentor giving your last piece of advice before you're gone.",hint:"Make every word count."},angry_rant:{id:"angry_rant",group:"emotional_monologues",title:"Angry Rant",description:"Something has pushed you over the edge.",hint:"Let it all out — pace, gesture, raise your voice, slam the table. Let the anger build and crash."},heartbroken_monologue:{id:"heartbroken_monologue",group:"emotional_monologues",title:"Heartbroken Monologue",description:"Someone you loved is gone.",hint:"Talk to them as if they can hear you. Let your voice break. Don't rush the pain."},desperate_plea:{id:"desperate_plea",group:"emotional_monologues",title:"Desperate Plea",description:"You need something desperately from the caller — forgiveness, help, a second chance.",hint:"Beg if you have to. Make them feel the weight."},joyful_outburst:{id:"joyful_outburst",group:"emotional_monologues",title:"Joyful Outburst",description:"Something incredible just happened.",hint:"Scream, jump, laugh, cry happy tears. Let the joy explode out of your body."},bitter_accusation:{id:"bitter_accusation",group:"emotional_monologues",title:"Bitter Accusation",description:"Someone wronged you.",hint:"Look them in the eye (the camera) and lay out every detail of how they hurt you. Cold at first, then raw."},grateful_tears:{id:"grateful_tears",group:"emotional_monologues",title:"Grateful Tears",description:"Someone did something you never expected.",hint:"Try to thank them but keep getting overwhelmed. Let gratitude break your composure."},frustrated_breakdown:{id:"frustrated_breakdown",group:"emotional_monologues",title:"Frustrated Breakdown",description:"Nothing is working. You've tried everything.",hint:"Show the exhaustion, the disbelief, the moment you almost give up — and then either do or don't."},jealous_confrontation:{id:"jealous_confrontation",group:"emotional_monologues",title:"Jealous Confrontation",description:"You're jealous and you know it. Confront the person (caller).",hint:"Try to be rational but let the jealousy leak through."},proud_parent_moment:{id:"proud_parent_moment",group:"emotional_monologues",title:"Proud Parent Moment",description:"Your child just accomplished something.",hint:"Tell the story to the caller — try to stay composed but can't help getting emotional."},rehearsed_apology:{id:"rehearsed_apology",group:"emotional_monologues",title:"Apology You've Been Rehearsing",description:"You've been preparing this apology for a long time.",hint:"Deliver it — every word matters, every pause is deliberate. Watch for the reaction."},emotion_roulette:{id:"emotion_roulette",group:"interactive_commands",title:"Emotion Roulette",description:"The caller calls out emotions one after another.",hint:"Switch between them instantly — happy, sad, angry, scared, disgusted, surprised. Full body commitment."},character_switchboard:{id:"character_switchboard",group:"interactive_commands",title:"Character Switchboard",description:"The caller names different characters or types (old man, child, robot, royalty).",hint:"You instantly become them. Voice, posture, mannerisms — all change."},action_commands:{id:"action_commands",group:"interactive_commands",title:"Action Commands",description:'The caller gives physical commands: "freeze," "slow motion," "run in place," "fall down," "celebrate."',hint:"You execute immediately and fully."},vocal_range_test:{id:"vocal_range_test",group:"interactive_commands",title:"Vocal Range Test",description:"The caller asks you to speak in different ways: whisper, shout, sing, cry, laugh, stutter, speak fast, speak slow.",hint:"Switch on command."},mime_challenges:{id:"mime_challenges",group:"interactive_commands",title:"Mime Challenges",description:'The caller describes scenarios: "You\'re trapped in a box," "You\'re walking against the wind," "You\'re pulling a heavy rope."',hint:"Mime each one silently."},status_shifts:{id:"status_shifts",group:"interactive_commands",title:"Status Shifts",description:'The caller tells you to shift your social status: "You\'re the king," "Now you\'re the servant," "Now you\'re equal."',hint:"Show each shift in your body and voice."},speed_dial_emotions:{id:"speed_dial_emotions",group:"interactive_commands",title:"Speed Dial Emotions",description:"The caller gives you a number 1-10 for emotional intensity.",hint:"At 1, you barely react. At 10, you're at maximum. They change the number throughout."},freeze_frame:{id:"freeze_frame",group:"interactive_commands",title:"Freeze Frame",description:'You perform a scene. When the caller says "freeze," hold your exact position.',hint:'When they say "go," continue. They can redirect the scene during freezes.'},animal_transformation:{id:"animal_transformation",group:"interactive_commands",title:"Animal Transformation",description:"The caller names animals.",hint:"You take on their physicality — how they move, sound, react. Transition between animals on command."},rewind_replay:{id:"rewind_replay",group:"interactive_commands",title:"Rewind & Replay",description:'Perform a short scene. The caller says "rewind" — do it backwards. "Replay" — do it again differently. "Fast forward" — skip ahead.',hint:"Follow the directions precisely."},genre_shift:{id:"genre_shift",group:"interactive_commands",title:"Genre Shift",description:'You\'re doing a scene. The caller changes the genre: "Now it\'s a horror," "Now it\'s a comedy," "Now it\'s a musical."',hint:"Adapt instantly."},conductor:{id:"conductor",group:"interactive_commands",title:"Conductor",description:"The caller controls your volume and intensity like a conductor — hands up = louder/bigger, hands down = softer/smaller.",hint:"Follow their lead. (Caller must be on camera with visible gestures.)"},roommate_blowup:{id:"roommate_blowup",group:"confrontation_conflict",title:"Roommate Blowup",description:"Your roommate (the caller) hasn't done their share for months.",hint:"You've been holding it in. Not anymore."},sibling_rivalry:{id:"sibling_rivalry",group:"confrontation_conflict",title:"Sibling Rivalry",description:"You and your sibling (the caller) are fighting over something that's really about something deeper.",hint:"Dig into the real issue."},business_partner_split:{id:"business_partner_split",group:"confrontation_conflict",title:"Business Partner Split",description:"Your partner (the caller) wants to go in a different direction.",hint:"It's personal now. Argue about money, trust, and vision."},caught_cheating:{id:"caught_cheating",group:"confrontation_conflict",title:"Caught Cheating",description:"You've been caught being unfaithful (or catch the caller).",hint:"The confrontation is messy — excuses, anger, tears, silence."},neighborhood_dispute:{id:"neighborhood_dispute",group:"confrontation_conflict",title:"Neighborhood Dispute",description:"Your neighbor (the caller) crossed a line.",hint:"Fight about noise, boundaries, property. Start petty, get personal."},teacher_vs_parent:{id:"teacher_vs_parent",group:"confrontation_conflict",title:"Teacher vs. Parent",description:"You're the teacher; the caller is an angry parent (or vice versa).",hint:"Clash over what's right for the child."},old_wound_reopened:{id:"old_wound_reopened",group:"confrontation_conflict",title:"Old Wound Reopened",description:"Something the caller says casually triggers a deep old hurt.",hint:"It's not about what they just said — it's about what happened years ago. Let the buried pain slowly surface and spill over."},workplace_showdown:{id:"workplace_showdown",group:"confrontation_conflict",title:"Workplace Showdown",description:"A coworker (the caller) took credit for your work.",hint:"Confront them. They deny it. It escalates."},family_video_call_explosion:{id:"family_video_call_explosion",group:"confrontation_conflict",title:"Family Video Call Explosion",description:"You're on a family group video call and something sets you off.",hint:"What starts polite ends in raised voices and pointed accusations."},making_up_after_fight:{id:"making_up_after_fight",group:"confrontation_conflict",title:"Making Up After a Fight",description:"You and the caller just had a terrible fight. Now you're trying to reconcile.",hint:"It's fragile. One wrong word and it reignites."}},o={personal_life:{id:"personal_life",name:"Personal Life & Interests & Hobbies & Skills",description:"Topics about your personal interests, hobbies, and skills.",examples:["Sports/Fitness","Cooking/Baking","Video Games","DIY/Home Repair","Painting/Art","Playing an Instrument","Gardening","Photography","Makeup/Skincare routines","Collecting items"]},memorable_moments:{id:"memorable_moments",name:"Memorable Moments & Personal Stories",description:"Share stories from your past experiences.",examples:["A memorable travel mishap","Childhood pranks","Family traditions","First dates (good or bad)","School/University days","An embarrassing moment","A time you were injured or sick","A surprising encounter"]},opinions_reviews:{id:"opinions_reviews",name:"Opinions & Reviews",description:"Things you strongly like, dislike, or wish to discuss.",examples:["Movie/TV Show reviews","Restaurant/Food critiques","Fashion trends","Tech gadgets (Phones/Laptops)","Music tastes","Book recommendations","Celebrity gossip","Social media trends",'"Pet peeves" (things that annoy you)']},career_expertise:{id:"career_expertise",name:"Career & Expertise",description:"Insights into your job, studies, or area of special knowledge.",examples:['A "Day in the Life" of your job',"Handling difficult customers/clients","Career advice","Industry secrets","Explaining a complex concept","Academic research","Internship experiences","How to ace a job interview"]},imagination_possibility:{id:"imagination_possibility",name:"Imagination & Possibility",description:'Games of imagination and "What If" questions.',examples:['"If I won the lottery..."','"If I had a superpower..."','"If I could time travel..."','"My Zombie Apocalypse survival plan"','"If I could have dinner with anyone living or dead..."','"Living on Mars vs. Underwater"']}},i={a1:{id:"a1",category:"request_explanation",instruction:"Ask the host to explain their topic as if you're a complete beginner who knows nothing."},a2:{id:"a2",category:"request_explanation",instruction:"Ask the host to walk you through the single most important step in full detail."},a3:{id:"a3",category:"request_explanation",instruction:'Ask "why?" about something the host just said and listen to their full reasoning.'},a4:{id:"a4",category:"request_explanation",instruction:"Ask the host to explain the same thing using a completely different analogy."},a5:{id:"a5",category:"request_explanation",instruction:"Tell the host you're confused and ask them to start over from the beginning."},a6:{id:"a6",category:"request_explanation",instruction:"Ask the host to explain the hardest or trickiest part of what they're talking about."},a7:{id:"a7",category:"request_explanation",instruction:"Ask the host to compare what they're explaining to something from everyday life."},a8:{id:"a8",category:"request_explanation",instruction:"Ask the host to give you three real examples to make their point clearer."},a9:{id:"a9",category:"request_explanation",instruction:"Ask the host what the most common mistake or misconception is about their topic."},a10:{id:"a10",category:"request_explanation",instruction:"Ask the host what first got them interested in this and how they learned it."},a11:{id:"a11",category:"request_explanation",instruction:"Ask the host to summarize everything they've said in one sentence."},a12:{id:"a12",category:"request_explanation",instruction:"Ask the host to explain the opposite perspective or counterargument."},a13:{id:"a13",category:"request_explanation",instruction:"Ask the host how they would explain this to a child."},a14:{id:"a14",category:"request_explanation",instruction:"Ask the host what they would teach next if you had more time together."},a15:{id:"a15",category:"request_explanation",instruction:"Ask the host what resource they'd recommend if you wanted to learn more on your own."},b1:{id:"b1",category:"request_demonstration",instruction:"Ask the host to stand up and demonstrate what they're describing with their whole body."},b2:{id:"b2",category:"request_demonstration",instruction:"Ask the host to show the steps with their hands while explaining each one."},b3:{id:"b3",category:"request_demonstration",instruction:"Ask the host to act out a real scenario related to their topic."},b4:{id:"b4",category:"request_demonstration",instruction:"Ask the host to demonstrate the wrong way first, then the right way."},b5:{id:"b5",category:"request_demonstration",instruction:"Ask the host to show you everything in slow motion so you can follow along."},b6:{id:"b6",category:"request_demonstration",instruction:"Ask the host to demonstrate without using any words — actions only."},b7:{id:"b7",category:"request_demonstration",instruction:"Ask the host to use objects around them to illustrate what they mean."},b8:{id:"b8",category:"request_demonstration",instruction:"Ask the host to show the size, shape, or scale of something with their body."},b9:{id:"b9",category:"request_demonstration",instruction:"Ask the host to walk through a process step by step in real time."},b10:{id:"b10",category:"request_demonstration",instruction:"Ask the host to demonstrate while you try to copy them simultaneously."},b11:{id:"b11",category:"request_demonstration",instruction:"Ask the host to show the difference between two things side by side."},b12:{id:"b12",category:"request_demonstration",instruction:"Ask the host to exaggerate their movements so you can see each detail clearly."},b13:{id:"b13",category:"request_demonstration",instruction:'Ask the host to demonstrate with a constraint ("now do it with one hand" or "eyes closed").'},b14:{id:"b14",category:"request_demonstration",instruction:"Ask the host to demonstrate something from memory — something they haven't done in a while."},b15:{id:"b15",category:"request_demonstration",instruction:"Ask the host to show you their full process from start to finish without stopping."},c1:{id:"c1",category:"trigger_stories",instruction:"Ask the host about the very first time they ever did this. How did it go?"},c2:{id:"c2",category:"trigger_stories",instruction:"Ask the host for their most embarrassing experience related to this topic."},c3:{id:"c3",category:"trigger_stories",instruction:"Ask the host about a time this went completely wrong."},c4:{id:"c4",category:"trigger_stories",instruction:"Ask the host who taught them this and what that person was like."},c5:{id:"c5",category:"trigger_stories",instruction:"Ask the host about their proudest moment related to what they're sharing."},c6:{id:"c6",category:"trigger_stories",instruction:"Ask the host about a time they had to use this skill under real pressure."},c7:{id:"c7",category:"trigger_stories",instruction:"Ask the host to tell you about someone they admire in this area and why."},c8:{id:"c8",category:"trigger_stories",instruction:"Ask the host about a funny or unexpected memory connected to this topic."},c9:{id:"c9",category:"trigger_stories",instruction:"Ask the host about a time they completely changed their mind about this."},c10:{id:"c10",category:"trigger_stories",instruction:"Ask the host about the worst advice they've ever received on this topic."},c11:{id:"c11",category:"trigger_stories",instruction:"Ask the host about a beginner mistake they made that they'll never forget."},c12:{id:"c12",category:"trigger_stories",instruction:"Ask the host about a time this brought them genuine joy."},c13:{id:"c13",category:"trigger_stories",instruction:"Ask the host about a moment when this skill or knowledge truly mattered."},c14:{id:"c14",category:"trigger_stories",instruction:"Ask the host what they would do differently if they could start over."},c15:{id:"c15",category:"trigger_stories",instruction:"Ask the host to describe the moment they realized they were actually good at this."},d1:{id:"d1",category:"challenge_disagree",instruction:"Tell the host you disagree with their main point and ask them to convince you."},d2:{id:"d2",category:"challenge_disagree",instruction:"Point out a gap or flaw in what the host just said and see how they handle it."},d3:{id:"d3",category:"challenge_disagree",instruction:'Ask the host "what if you\'re completely wrong about this?"'},d4:{id:"d4",category:"challenge_disagree",instruction:"Challenge the host to defend their position against a counterargument you invent."},d5:{id:"d5",category:"challenge_disagree",instruction:"Tell the host someone else told you the complete opposite — ask who's right and why."},d6:{id:"d6",category:"challenge_disagree",instruction:"Ask the host to prove what they're saying with a live demonstration."},d7:{id:"d7",category:"challenge_disagree",instruction:"Question whether the host's approach is really the best way to do this."},d8:{id:"d8",category:"challenge_disagree",instruction:"Play devil's advocate — take the opposing side and argue it seriously."},d9:{id:"d9",category:"challenge_disagree",instruction:"Ask the host what the weakest part of their own argument is."},d10:{id:"d10",category:"challenge_disagree",instruction:"Tell the host you've heard this is outdated — is that true?"},d11:{id:"d11",category:"challenge_disagree",instruction:"Challenge the host to explain why anyone should care about this."},d12:{id:"d12",category:"challenge_disagree",instruction:'Express doubt about the host\'s experience — "have you actually done this yourself?"'},d13:{id:"d13",category:"challenge_disagree",instruction:"Ask the host what evidence would change their mind."},d14:{id:"d14",category:"challenge_disagree",instruction:"Challenge the host to do what they're describing better, faster, or differently."},d15:{id:"d15",category:"challenge_disagree",instruction:"Tell the host their explanation doesn't make sense to you and watch how they adjust."},e1:{id:"e1",category:"emotional_prompts",instruction:"Tell the host you have some bad news and deliver a made-up scenario. Watch them react."},e2:{id:"e2",category:"emotional_prompts",instruction:"Share something exciting with the host and see how they celebrate with you."},e3:{id:"e3",category:"emotional_prompts",instruction:"Pretend to get upset about something the host said and see how they recover."},e4:{id:"e4",category:"emotional_prompts",instruction:"Tell the host something that should make them feel proud of what they've shared."},e5:{id:"e5",category:"emotional_prompts",instruction:"Act scared or worried about something and see how the host comforts you."},e6:{id:"e6",category:"emotional_prompts",instruction:"Express genuine gratitude for what the host is teaching you. Let it land."},e7:{id:"e7",category:"emotional_prompts",instruction:"Pretend to be visibly bored and see how the host tries to re-engage you."},e8:{id:"e8",category:"emotional_prompts",instruction:"Tell the host this reminds you of someone you miss. Let the moment sit."},e9:{id:"e9",category:"emotional_prompts",instruction:"Act suddenly excited about a minor detail the host mentioned. Blow it up."},e10:{id:"e10",category:"emotional_prompts",instruction:"Pretend to be overwhelmed by information and ask the host to slow down and help."},e11:{id:"e11",category:"emotional_prompts",instruction:'Express genuine surprise — "I had no idea! That changes everything."'},e12:{id:"e12",category:"emotional_prompts",instruction:"Tell the host this topic makes you nervous and see how they encourage you."},e13:{id:"e13",category:"emotional_prompts",instruction:"Share a moment of vulnerability and see if the host opens up in return."},e14:{id:"e14",category:"emotional_prompts",instruction:"Express disappointment about something and observe the host's response."},e15:{id:"e15",category:"emotional_prompts",instruction:"Tell the host you're having a rough day and see how they shift their energy."},f1:{id:"f1",category:"creative_challenges",instruction:"Ask the host to make up a song or jingle about their topic right now."},f2:{id:"f2",category:"creative_challenges",instruction:"Ask the host to explain their topic as if it's a fairy tale or bedtime story."},f3:{id:"f3",category:"creative_challenges",instruction:"Challenge the host to describe what they're doing using only sound effects."},f4:{id:"f4",category:"creative_challenges",instruction:"Ask the host to teach the same thing but in the style of a drill sergeant."},f5:{id:"f5",category:"creative_challenges",instruction:"Ask the host to improvise a 30-second commercial for their topic."},f6:{id:"f6",category:"creative_challenges",instruction:"Challenge the host to explain their topic in exactly 10 words. Then let them elaborate."},f7:{id:"f7",category:"creative_challenges",instruction:"Ask the host to draw or sketch what they mean while explaining it."},f8:{id:"f8",category:"creative_challenges",instruction:"Ask the host to create a rhyme or mnemonic to help you remember."},f9:{id:"f9",category:"creative_challenges",instruction:"Challenge the host to explain their topic using only questions — no statements."},f10:{id:"f10",category:"creative_challenges",instruction:"Ask the host to act out both sides of a conversation about their topic."},f11:{id:"f11",category:"creative_challenges",instruction:"Challenge the host to make their topic sound like the most exciting thing in the world."},f12:{id:"f12",category:"creative_challenges",instruction:"Ask the host to teach you using only gestures and no words."},f13:{id:"f13",category:"creative_challenges",instruction:"Ask the host to come up with a metaphor they've never used before."},f14:{id:"f14",category:"creative_challenges",instruction:"Ask the host to freestyle — say whatever comes to mind for 30 seconds straight."},f15:{id:"f15",category:"creative_challenges",instruction:"Challenge the host to explain their topic as if they're a sports commentator calling a big game."},g1:{id:"g1",category:"personal_probes",instruction:"Ask the host why this topic matters to them personally — not generally, but to THEM."},g2:{id:"g2",category:"personal_probes",instruction:"Ask the host what they would change about themselves if they could."},g3:{id:"g3",category:"personal_probes",instruction:"Ask the host to describe themselves in three words and explain each one."},g4:{id:"g4",category:"personal_probes",instruction:"Ask the host what they're most afraid of."},g5:{id:"g5",category:"personal_probes",instruction:"Ask the host what they're grateful for today."},g6:{id:"g6",category:"personal_probes",instruction:"Ask the host about their happiest memory and let them relive it."},g7:{id:"g7",category:"personal_probes",instruction:"Ask the host what they'd do if they had no responsibilities for a week."},g8:{id:"g8",category:"personal_probes",instruction:"Ask the host who they'd want to have dinner with — living or dead — and why."},g9:{id:"g9",category:"personal_probes",instruction:"Ask the host what they wish more people understood about them."},g10:{id:"g10",category:"personal_probes",instruction:"Ask the host what they've learned about themselves recently."},g11:{id:"g11",category:"personal_probes",instruction:"Ask the host what motivates them to keep going on hard days."},g12:{id:"g12",category:"personal_probes",instruction:"Ask the host about a relationship that changed how they see the world."},g13:{id:"g13",category:"personal_probes",instruction:"Ask the host about a risk they took that paid off — or didn't."},g14:{id:"g14",category:"personal_probes",instruction:"Ask the host what they want to be remembered for."},g15:{id:"g15",category:"personal_probes",instruction:"Ask the host about a time they genuinely surprised themselves."},h1:{id:"h1",category:"direction_redirect",instruction:"Ask the host to switch to a completely different subtopic within their subject."},h2:{id:"h2",category:"direction_redirect",instruction:"Tell the host to do the same thing but with twice the energy."},h3:{id:"h3",category:"direction_redirect",instruction:"Ask the host to restart their explanation but take a totally different approach."},h4:{id:"h4",category:"direction_redirect",instruction:"Tell the host to slow down dramatically and be as deliberate as possible."},h5:{id:"h5",category:"direction_redirect",instruction:"Ask the host to stand up and continue from a different position in the room."},h6:{id:"h6",category:"direction_redirect",instruction:"Tell the host to pretend you just arrived — introduce and start from scratch."},h7:{id:"h7",category:"direction_redirect",instruction:"Ask the host to switch from explaining to demonstrating (or vice versa)."},h8:{id:"h8",category:"direction_redirect",instruction:"Tell the host to continue but as if they're whispering a secret."},h9:{id:"h9",category:"direction_redirect",instruction:"Ask the host to change their mood — go from serious to lighthearted, or the reverse."},h10:{id:"h10",category:"direction_redirect",instruction:"Tell the host to take a deep breath, collect their thoughts, then continue."},h11:{id:"h11",category:"direction_redirect",instruction:"Ask the host to address the camera directly as if talking to someone else."},h12:{id:"h12",category:"direction_redirect",instruction:"Tell the host to skip ahead to the most interesting or surprising part."},h13:{id:"h13",category:"direction_redirect",instruction:"Ask the host to pause, think about what they really want to say, then say it."},h14:{id:"h14",category:"direction_redirect",instruction:"Tell the host to continue but be extremely brief — one sentence per point."},h15:{id:"h15",category:"direction_redirect",instruction:"Ask the host to suddenly freeze, count to five silently, then continue as if nothing happened."},i1:{id:"i1",category:"games_contests",instruction:"Quiz the host about their own topic — ask detailed questions and see if they know."},i2:{id:"i2",category:"games_contests",instruction:'Play "would you rather" with choices related to the host\'s topic.'},i3:{id:"i3",category:"games_contests",instruction:"Challenge the host to keep talking while you try to distract them."},i4:{id:"i4",category:"games_contests",instruction:'Play "true or false" — make claims and see if the host catches the lies.'},i5:{id:"i5",category:"games_contests",instruction:"Challenge the host to explain their topic in under 30 seconds. Time them."},i6:{id:"i6",category:"games_contests",instruction:'Play "finish the sentence" — start a statement and make the host complete it.'},i7:{id:"i7",category:"games_contests",instruction:"Challenge the host to go back and forth with you, each adding one detail."},i8:{id:"i8",category:"games_contests",instruction:"Deliberately get something wrong and see if the host catches and corrects it."},i9:{id:"i9",category:"games_contests",instruction:"Challenge the host to teach you while you mimic everything they do in real time."},i10:{id:"i10",category:"games_contests",instruction:"Play rapid fire — ask quick questions the host must answer immediately."},i11:{id:"i11",category:"games_contests",instruction:"Challenge the host to talk about their topic without using a specific common word."},i12:{id:"i12",category:"games_contests",instruction:"Take turns building on an idea — each of you adds a new layer."},i13:{id:"i13",category:"games_contests",instruction:"Challenge the host to switch topics on your signal and switch back on another."},i14:{id:"i14",category:"games_contests",instruction:'Play "hot seat" — ask increasingly personal or difficult questions.'},i15:{id:"i15",category:"games_contests",instruction:"Ask the host to rank their top 3 of something and defend the order."},j1:{id:"j1",category:"problem_solving",instruction:"Present a hypothetical scenario and ask the host how they'd handle it step by step."},j2:{id:"j2",category:"problem_solving",instruction:'Describe a problem you\'re "having" and ask the host to troubleshoot it with you.'},j3:{id:"j3",category:"problem_solving",instruction:"Ask the host what they'd do in an extreme or unusual version of their topic."},j4:{id:"j4",category:"problem_solving",instruction:"Give the host a constraint and ask them to solve around it creatively."},j5:{id:"j5",category:"problem_solving",instruction:"Present two options and ask the host to decide which is better and explain why."},j6:{id:"j6",category:"problem_solving",instruction:"Ask the host to plan something on the spot — a trip, a project, a meal, an event."},j7:{id:"j7",category:"problem_solving",instruction:'Give the host a "what if" that completely breaks their assumptions.'},j8:{id:"j8",category:"problem_solving",instruction:"Ask the host to solve a problem using only things visible in the room."},j9:{id:"j9",category:"problem_solving",instruction:"Present a dilemma with no clear right answer and think through it together."},j10:{id:"j10",category:"problem_solving",instruction:"Ask the host to figure out how to teach their topic to someone very different from you."},j11:{id:"j11",category:"problem_solving",instruction:"Give the host a budget or time constraint and ask them to work within it."},j12:{id:"j12",category:"problem_solving",instruction:"Present a scenario where the host's usual approach wouldn't work. What now?"},j13:{id:"j13",category:"problem_solving",instruction:"Ask the host to prioritize — what's most important and what can be cut?"},j14:{id:"j14",category:"problem_solving",instruction:"Give the host a fictional deadline and ask them to make a quick plan."},j15:{id:"j15",category:"problem_solving",instruction:"Describe a situation going wrong mid-process and ask the host to rescue it."},k1:{id:"k1",category:"comfort_connection",instruction:"Tell the host you're having a bad day and see how they respond and comfort you."},k2:{id:"k2",category:"comfort_connection",instruction:"Compliment the host genuinely and observe how they receive it over time."},k3:{id:"k3",category:"comfort_connection",instruction:"Share a worry with the host and see if they offer real comfort or advice."},k4:{id:"k4",category:"comfort_connection",instruction:"Tell the host specifically what you appreciate about how they're explaining this."},k5:{id:"k5",category:"comfort_connection",instruction:"Ask the host what they do when they themselves are feeling down."},k6:{id:"k6",category:"comfort_connection",instruction:"Express that you're nervous about trying what the host is showing you."},k7:{id:"k7",category:"comfort_connection",instruction:"Share a small personal victory and see if the host celebrates with you."},k8:{id:"k8",category:"comfort_connection",instruction:"Tell the host they remind you of someone you care about and explain why."},k9:{id:"k9",category:"comfort_connection",instruction:"Ask the host for advice on something personal and listen to their full answer."},k10:{id:"k10",category:"comfort_connection",instruction:"Express frustration with yourself and see how the host lifts you up."},k11:{id:"k11",category:"comfort_connection",instruction:"Thank the host sincerely for their time and see how the warmth settles in."},k12:{id:"k12",category:"comfort_connection",instruction:"Tell the host you trust them and observe how that changes the dynamic."},k13:{id:"k13",category:"comfort_connection",instruction:"Ask the host to share a time someone comforted them when they needed it."},k14:{id:"k14",category:"comfort_connection",instruction:"Tell the host something honest and kind and let the silence after it breathe."},k15:{id:"k15",category:"comfort_connection",instruction:"Ask the host what they'd say to someone who's going through a hard time right now."},l1:{id:"l1",category:"collaborate_cocreate",instruction:"Suggest building on each other's ideas — one at a time, back and forth."},l2:{id:"l2",category:"collaborate_cocreate",instruction:"Ask the host to start something and you'll finish it, then switch roles."},l3:{id:"l3",category:"collaborate_cocreate",instruction:"Propose doing the same action at the same time and compare your versions."},l4:{id:"l4",category:"collaborate_cocreate",instruction:"Ask the host to teach you a specific move or phrase, then practice it together."},l5:{id:"l5",category:"collaborate_cocreate",instruction:"Suggest taking turns being the expert and the student — swap every minute."},l6:{id:"l6",category:"collaborate_cocreate",instruction:"Ask the host to describe something while you try to act it out in real time."},l7:{id:"l7",category:"collaborate_cocreate",instruction:"Propose planning something together — each contributing different parts."},l8:{id:"l8",category:"collaborate_cocreate",instruction:"Ask the host to give you step-by-step instructions and follow them live."},l9:{id:"l9",category:"collaborate_cocreate",instruction:"Suggest you both share your own version of the same story or memory."},l10:{id:"l10",category:"collaborate_cocreate",instruction:"Propose a toast or celebration for something you've accomplished together."},l11:{id:"l11",category:"collaborate_cocreate",instruction:"Ask the host to start a rhythm, pattern, or chant and you'll join in."},l12:{id:"l12",category:"collaborate_cocreate",instruction:"Suggest you both attempt something you've never tried before at the same time."},l13:{id:"l13",category:"collaborate_cocreate",instruction:"Ask the host to quiz you on what they've taught, then you quiz them back."},l14:{id:"l14",category:"collaborate_cocreate",instruction:"Propose making a decision together — weigh options, negotiate, compromise."},l15:{id:"l15",category:"collaborate_cocreate",instruction:"Ask the host to role-play a scenario with you where you each play a part."},m1:{id:"m1",category:"test_quiz",instruction:"Ask a detailed follow-up question about something the host glossed over."},m2:{id:"m2",category:"test_quiz",instruction:"Ask the host to repeat what they said earlier — from memory, no cheating."},m3:{id:"m3",category:"test_quiz",instruction:"Present a new scenario and ask the host to apply their knowledge to it."},m4:{id:"m4",category:"test_quiz",instruction:"Ask the host to name all the steps of something without pausing to think."},m5:{id:"m5",category:"test_quiz",instruction:'Quiz the host on specifics — "what temperature?", "how long?", "what order?"'},m6:{id:"m6",category:"test_quiz",instruction:"Ask the host to demonstrate something they haven't practiced in a long time."},m7:{id:"m7",category:"test_quiz",instruction:"Test whether the host can explain this in a completely different style or register."},m8:{id:"m8",category:"test_quiz",instruction:"Ask the host to perform with a handicap (one hand, no looking, backwards)."},m9:{id:"m9",category:"test_quiz",instruction:"Quiz the host about edge cases or exceptions to what they've been teaching."},m10:{id:"m10",category:"test_quiz",instruction:"Ask the host to reproduce or recite something entirely from memory."},m11:{id:"m11",category:"test_quiz",instruction:"Test whether the host can answer rapid-fire questions without hesitation."},m12:{id:"m12",category:"test_quiz",instruction:"Ask the host to predict what would happen in a scenario they haven't considered."},m13:{id:"m13",category:"test_quiz",instruction:"Ask the host to teach the same thing but to a completely different audience."},m14:{id:"m14",category:"test_quiz",instruction:"Challenge the host to find a mistake you deliberately planted in your understanding."},m15:{id:"m15",category:"test_quiz",instruction:"Ask the host to connect their topic to something completely unrelated."},n1:{id:"n1",category:"observe_react",instruction:"Show the host something on your phone and ask them to react and discuss it."},n2:{id:"n2",category:"observe_react",instruction:"Make an unexpected sound and see how the host reacts and recovers."},n3:{id:"n3",category:"observe_react",instruction:"Suddenly change your own energy (get quiet, get loud) and see if the host adapts."},n4:{id:"n4",category:"observe_react",instruction:"Start doing something unusual and see if the host comments, copies, or ignores it."},n5:{id:"n5",category:"observe_react",instruction:"Pretend to notice something off-camera and see how the host responds."},n6:{id:"n6",category:"observe_react",instruction:"Go completely quiet for 10 seconds and observe how the host fills the silence."},n7:{id:"n7",category:"observe_react",instruction:"Present the host with a surprising fact and watch their genuine reaction unfold."},n8:{id:"n8",category:"observe_react",instruction:"Start laughing and see if the host catches the laughter or asks what's funny."},n9:{id:"n9",category:"observe_react",instruction:"Pretend to be distracted by your phone and see how the host re-engages you."},n10:{id:"n10",category:"observe_react",instruction:"React strongly to something small the host said and see how they handle it."},n11:{id:"n11",category:"observe_react",instruction:"Pretend someone just walked into your room and see how the host responds."},n12:{id:"n12",category:"observe_react",instruction:"Change your posture dramatically (stand up, sit on floor) and watch the host adjust."},n13:{id:"n13",category:"observe_react",instruction:"Introduce a prop or object into the conversation and see how the host incorporates it."},n14:{id:"n14",category:"observe_react",instruction:"Mimic the host's gestures or speech patterns and see how long until they notice."},n15:{id:"n15",category:"observe_react",instruction:"Express a strong opinion about something the host just showed and watch them engage."},o1:{id:"o1",category:"shift_transform",instruction:"Ask the host to continue but as a completely different character or persona."},o2:{id:"o2",category:"shift_transform",instruction:"Tell the host to switch from casual to formal — or formal to casual."},o3:{id:"o3",category:"shift_transform",instruction:"Ask the host to continue as if they're confessing something they've never told anyone before."},o4:{id:"o4",category:"shift_transform",instruction:"Tell the host to pretend they're on stage in front of a huge audience."},o5:{id:"o5",category:"shift_transform",instruction:"Ask the host to switch emotions — go from happy to serious, or shy to confident."},o6:{id:"o6",category:"shift_transform",instruction:"Tell the host to do everything in slow motion for the next 30 seconds."},o7:{id:"o7",category:"shift_transform",instruction:"Ask the host to pretend this is the last time they'll ever explain this topic."},o8:{id:"o8",category:"shift_transform",instruction:"Tell the host to switch to being extremely brief — maximum one sentence per point."},o9:{id:"o9",category:"shift_transform",instruction:"Ask the host to continue as if they're in a huge rush and almost out of time."},o10:{id:"o10",category:"shift_transform",instruction:"Tell the host to pretend they're talking to their best friend in the whole world."},o11:{id:"o11",category:"shift_transform",instruction:"Ask the host to be way more physical — use their entire body, move around."},o12:{id:"o12",category:"shift_transform",instruction:"Tell the host to switch to the opposite energy of whatever they're currently doing."},o13:{id:"o13",category:"shift_transform",instruction:"Ask the host to continue as if they're trying to impress someone important."},o14:{id:"o14",category:"shift_transform",instruction:"Tell the host to pretend they're doing this for the very first time."},o15:{id:"o15",category:"shift_transform",instruction:"Ask the host to drop all pretense and be as raw and honest as possible."},p1:{id:"p1",category:"physical_movement",instruction:"Tell the host to stand up and continue the conversation while moving around the space."},p2:{id:"p2",category:"physical_movement",instruction:"Ask the host to demonstrate something using their entire body — arms, legs, posture."},p3:{id:"p3",category:"physical_movement",instruction:"Tell the host to act something out physically while you narrate what's happening."},p4:{id:"p4",category:"physical_movement",instruction:"Ask the host to show you two different ways to do something — one sitting, one standing."},p5:{id:"p5",category:"physical_movement",instruction:"Tell the host to stretch, get comfortable, and then settle into a new position before continuing."},p6:{id:"p6",category:"physical_movement",instruction:"Ask the host to walk you through a physical routine — exercise, dance, self-defense, yoga."},p7:{id:"p7",category:"physical_movement",instruction:"Tell the host to use the full space — move from one side to the other while explaining."},p8:{id:"p8",category:"physical_movement",instruction:"Ask the host to mime an entire process from start to finish without any objects."},p9:{id:"p9",category:"physical_movement",instruction:"Tell the host to sit on the floor and continue the conversation from there."},p10:{id:"p10",category:"physical_movement",instruction:"Ask the host to lean in close as if sharing something private, then lean back to explain more."},p11:{id:"p11",category:"physical_movement",instruction:"Tell the host to turn away from the camera, do something, then turn back and reveal the result."},p12:{id:"p12",category:"physical_movement",instruction:"Ask the host to crouch down, pick something up (real or mimed), and use it in their explanation."},p13:{id:"p13",category:"physical_movement",instruction:"Tell the host to pace back and forth while thinking through a difficult point."},p14:{id:"p14",category:"physical_movement",instruction:"Ask the host to use hand gestures only — no words — to explain something for 30 seconds."},p15:{id:"p15",category:"physical_movement",instruction:"Tell the host to physically show the difference between two things using their body."},q1:{id:"q1",category:"emotional_expressive",instruction:"Tell the host something funny and let their laughter play out fully — don't rush past it."},q2:{id:"q2",category:"emotional_expressive",instruction:"Share news that makes the host visibly emotional. Let the reaction develop naturally."},q3:{id:"q3",category:"emotional_expressive",instruction:"Tell the host something awkward and watch them navigate the discomfort for an extended moment."},q4:{id:"q4",category:"emotional_expressive",instruction:"Ask the host to recall a moment that made them angry and let the frustration show on their face."},q5:{id:"q5",category:"emotional_expressive",instruction:"Tell the host something that should make them nervous. Watch how their body language changes."},q6:{id:"q6",category:"emotional_expressive",instruction:"Surprise the host with an unexpected compliment and let the warmth and embarrassment land."},q7:{id:"q7",category:"emotional_expressive",instruction:"Tell the host to close their eyes and describe how they're feeling right now — honestly."},q8:{id:"q8",category:"emotional_expressive",instruction:"Share a sad story and let the host sit with it — observe how empathy shows on their face."},q9:{id:"q9",category:"emotional_expressive",instruction:"Tell the host something that should make them proud. Watch them try to be humble about it."},q10:{id:"q10",category:"emotional_expressive",instruction:"Ask the host to show you what excitement looks like to them — let them build it up."},q11:{id:"q11",category:"emotional_expressive",instruction:"Tell the host to hold back a reaction to something you say — watch them struggle to contain it."},q12:{id:"q12",category:"emotional_expressive",instruction:"Deliver increasingly absurd statements and watch the host's face go from patient to disbelief."},q13:{id:"q13",category:"emotional_expressive",instruction:"Tell the host to take a deep breath and visibly relax their entire body before continuing."},q14:{id:"q14",category:"emotional_expressive",instruction:"Ask the host how they show someone they care without words. Let them demonstrate."},q15:{id:"q15",category:"emotional_expressive",instruction:"Tell the host to think about someone they love for 10 seconds, then describe how it feels."},r1:{id:"r1",category:"object_prop",instruction:"Ask the host to find a nearby object and use it as a prop to explain their topic."},r2:{id:"r2",category:"object_prop",instruction:"Tell the host to make or prepare something while continuing to talk (food, drink, craft)."},r3:{id:"r3",category:"object_prop",instruction:"Ask the host to show you three objects near them and tell you the story behind each one."},r4:{id:"r4",category:"object_prop",instruction:"Tell the host to tidy or rearrange something in their space while keeping the conversation going."},r5:{id:"r5",category:"object_prop",instruction:"Ask the host to write or draw something to illustrate their point — show the result to the camera."},r6:{id:"r6",category:"object_prop",instruction:"Tell the host to pour or prepare a drink and take a sip while explaining."},r7:{id:"r7",category:"object_prop",instruction:"Ask the host to use their phone to look something up related to their topic and share what they find."},r8:{id:"r8",category:"object_prop",instruction:"Tell the host to show you their desk, shelf, or workspace and pick items that relate to their topic."},r9:{id:"r9",category:"object_prop",instruction:"Ask the host to pack, wrap, or organize something while chatting casually."},r10:{id:"r10",category:"object_prop",instruction:"Tell the host to hold an object and use it as a pointer, prop, or comfort item while talking."},r11:{id:"r11",category:"object_prop",instruction:"Ask the host to demonstrate a process using real objects — assemble, disassemble, fix, or create."},r12:{id:"r12",category:"object_prop",instruction:"Tell the host to show you what's in their pockets, bag, or nearby drawer and discuss each item."},r13:{id:"r13",category:"object_prop",instruction:"Ask the host to build something small (stack, arrange, fold) while you continue the conversation."},r14:{id:"r14",category:"object_prop",instruction:"Tell the host to use a pen, marker, or chalk to sketch something while explaining it out loud."},r15:{id:"r15",category:"object_prop",instruction:"Ask the host to interact with something in their environment they haven't touched yet today."},s1:{id:"s1",category:"talent_performance",instruction:"Ask the host to show you a hidden talent — anything they're secretly good at."},s2:{id:"s2",category:"talent_performance",instruction:"Ask the host to sing a few lines of their favorite song and explain the choice."},s3:{id:"s3",category:"talent_performance",instruction:"Challenge the host to teach you a dance move right now — and do it with you."},s4:{id:"s4",category:"talent_performance",instruction:"Ask the host to show you a sport or martial arts move at full speed, then in slow motion."},s5:{id:"s5",category:"talent_performance",instruction:"Tell the host to get up and move their body — dance, stretch, exercise — whatever feels natural."},s6:{id:"s6",category:"talent_performance",instruction:"Ask the host to perform something physical they've been practicing or want to learn."},s7:{id:"s7",category:"talent_performance",instruction:"Challenge the host to hold a difficult physical pose and keep talking at the same time."},s8:{id:"s8",category:"talent_performance",instruction:"Ask the host to show off their best move — whatever that means to them."},s9:{id:"s9",category:"talent_performance",instruction:"Tell the host to walk across the room like they're on a runway. Own it."},s10:{id:"s10",category:"talent_performance",instruction:"Ask the host to beatbox, hum, whistle, or make music with their body."},s11:{id:"s11",category:"talent_performance",instruction:"Challenge the host to do as many of a physical exercise as they can in 30 seconds."},s12:{id:"s12",category:"talent_performance",instruction:"Ask the host to act out a fight scene, sports moment, or action sequence from a movie."},s13:{id:"s13",category:"talent_performance",instruction:"Tell the host to show you a warm-up routine — whatever they do before performing or exercising."},s14:{id:"s14",category:"talent_performance",instruction:"Ask the host to demonstrate the most impressive physical thing they can do right now."},s15:{id:"s15",category:"talent_performance",instruction:"Challenge the host to freestyle dance for 15 seconds, then freeze and explain what they were feeling."},t1:{id:"t1",category:"scene_acting",instruction:'Set a scene: "You just got a phone call that changed everything." Let the host perform the moment of receiving the news — picking up, listening, reacting.'},t2:{id:"t2",category:"scene_acting",instruction:'Tell the host: "You\'re about to walk into a room where everyone has betrayed you." Let them perform the entrance, the realization, the reaction.'},t3:{id:"t3",category:"scene_acting",instruction:"Tell the host: \"Deliver a monologue as if you're a character in a movie who's been wrongly accused.\" Full performance — voice, posture, emotion."},t4:{id:"t4",category:"scene_acting",instruction:'Set a scene: "You\'re saying goodbye to your home for the last time." Let the host walk through the space, touch things, remember.'},t5:{id:"t5",category:"scene_acting",instruction:'Tell the host: "You\'re a lawyer making your closing argument. The jury is right here." Let them perform it — persuasive, emotional, theatrical.'},t6:{id:"t6",category:"scene_acting",instruction:'Set a scene: "Someone you haven\'t seen in 20 years just walked through the door." Perform the recognition, the flood of emotion, the first words.'},t7:{id:"t7",category:"scene_acting",instruction:'Tell the host: "Perform a scene where you\'re trying to hold back tears but failing." Give them a context or let them choose one.'},t8:{id:"t8",category:"scene_acting",instruction:'Set a scene: "You\'re a soldier reading a letter from home." Let the host perform — reading silently, reacting, maybe reading parts aloud.'},t9:{id:"t9",category:"scene_acting",instruction:'Tell the host: "You\'re an actor who just won an award. Give your acceptance speech." Let the full performance unfold — shock, gratitude, tears, humor.'},t10:{id:"t10",category:"scene_acting",instruction:"Set a scene: \"You're trapped in an elevator with someone you've been avoiding.\" Perform the tension, the small talk, the inevitable confrontation."},t11:{id:"t11",category:"scene_acting",instruction:"Tell the host: \"Act out a scene where you're caught doing something you shouldn't be doing.\" The panic, the excuse, the cover-up attempt."},t12:{id:"t12",category:"scene_acting",instruction:'Set a scene: "You\'re telling your child a difficult truth for the first time." Gentle, careful, brave. Let the weight of it show.'},t13:{id:"t13",category:"scene_acting",instruction:"Tell the host: \"Perform the moment you realize you've made a terrible mistake — and it's too late to fix it.\" Let the realization wash over them."},t14:{id:"t14",category:"scene_acting",instruction:"Set a scene: \"You're at a funeral and you've been asked to speak, but you didn't prepare anything.\" Watch the host improvise through grief."},t15:{id:"t15",category:"scene_acting",instruction:'Tell the host: "You\'re a character who just discovered they have a superpower." Perform the discovery — confusion, testing, excitement, fear.'},u1:{id:"u1",category:"confrontation_sparring",instruction:"Start an argument with the host about something trivial. Escalate it deliberately. See how the host fights back and at what point they snap."},u2:{id:"u2",category:"confrontation_sparring",instruction:"Accuse the host of lying about something they said earlier. Be specific. Push until they defend themselves with real emotion."},u3:{id:"u3",category:"confrontation_sparring",instruction:"Tell the host: \"I don't believe you're actually good at this.\" Provoke them until they prove it or get genuinely frustrated."},u4:{id:"u4",category:"confrontation_sparring",instruction:"Play the role of an angry customer. Be unreasonable. See how the host handles the escalation — do they stay calm or break?"},u5:{id:"u5",category:"confrontation_sparring",instruction:'Tell the host: "Someone told me you said [something offensive] about me." Watch the denial, the confusion, the defense unfold.'},u6:{id:"u6",category:"confrontation_sparring",instruction:"Interrupt the host repeatedly and dismiss what they're saying. See how long before they push back and how they do it."},u7:{id:"u7",category:"confrontation_sparring",instruction:"Tell the host they're wrong about something they care deeply about. Don't back down. Make them defend with passion."},u8:{id:"u8",category:"confrontation_sparring",instruction:"Play the role of someone returning to confront the host years after a falling-out. Bring old grievances. Demand answers."},u9:{id:"u9",category:"confrontation_sparring",instruction:'Tell the host: "You always do this." Be vague enough that they have to figure out what you mean — then get more specific and angrier.'},u10:{id:"u10",category:"confrontation_sparring",instruction:"Pretend to be the host's ex. Bring up old arguments. Let the scene play out — accusation, counter-accusation, hurt, regret."},u11:{id:"u11",category:"confrontation_sparring",instruction:"Tell the host: \"I'm done with you. This is the last conversation we'll ever have.\" See how they react — fight, plead, accept, or surprise you."},u12:{id:"u12",category:"confrontation_sparring",instruction:"Be passive-aggressive toward the host. Give backhanded compliments, loaded silences, fake smiles. See if the host calls it out."},u13:{id:"u13",category:"confrontation_sparring",instruction:"Play a parent disappointed in the host's life choices. Express it with heavy sighs, comparisons to others, and \"I'm not angry, just disappointed.\""},u14:{id:"u14",category:"confrontation_sparring",instruction:"Demand an apology from the host for something they don't think they did wrong. Push until they either apologize or refuse."},u15:{id:"u15",category:"confrontation_sparring",instruction:"Start calm, then gradually raise the emotional temperature until you're both in a full argument. Then try to bring it back down together."},v1:{id:"v1",category:"interactive_commands",instruction:'Tell the host: "Show me what anger looks like on your body. Now sadness. Now joy. Now fear." Direct them through each one, spending at least 10 seconds on each.'},v2:{id:"v2",category:"interactive_commands",instruction:'Direct the host: "Walk to the other side of the room as if you own the world. Now walk back as if it just ended." Watch the transformation.'},v3:{id:"v3",category:"interactive_commands",instruction:'Tell the host: "Perform the same sentence in 5 different emotions." Give them the sentence and call out emotions one by one.'},v4:{id:"v4",category:"interactive_commands",instruction:"Command the host: \"Pick up an object. It's now the most precious thing in the world to you. Now it's disgusting. Now it's hilarious.\" Direct the shifts."},v5:{id:"v5",category:"interactive_commands",instruction:'Tell the host: "React to what I\'m about to say with your whole body — no words." Then deliver increasingly dramatic statements.'},v6:{id:"v6",category:"interactive_commands",instruction:"Direct the host: \"You're giving a speech but the audience keeps booing. Keep going. Now they start cheering. Now they're crying.\""},v7:{id:"v7",category:"interactive_commands",instruction:"Tell the host: \"Dance like nobody's watching. Now dance like everyone's watching. Now dance like your life depends on it.\""},v8:{id:"v8",category:"interactive_commands",instruction:'Command the host: "Sing the happiest song you know. Now sing it as the saddest song ever written."'},v9:{id:"v9",category:"interactive_commands",instruction:'Tell the host: "Pretend you\'re in an action movie. Move through the room — duck, roll, look around corners, signal to your team."'},v10:{id:"v10",category:"interactive_commands",instruction:'Direct the host: "Tell me a simple story — like buying coffee. But tell it like a thriller. Now like a romance. Now like a tragedy."'},v11:{id:"v11",category:"interactive_commands",instruction:'Tell the host: "Show me your morning routine, but perform it as if you\'re a robot. Now as an old person. Now as someone in a huge rush."'},v12:{id:"v12",category:"interactive_commands",instruction:"Command the host: \"Freeze right now. I'm going to describe a scene, and when I say 'action,' you're in it. Fully. Body and voice.\""},v13:{id:"v13",category:"interactive_commands",instruction:"Direct the host: \"You're a mime. Show me: you're stuck in a shrinking room. Now you're climbing a rope. Now you're in a rainstorm.\""},v14:{id:"v14",category:"interactive_commands",instruction:'Tell the host: "Speak directly to the camera. Deliver a message to someone who hurt you. Now deliver one to someone you miss. Now to your future self."'},v15:{id:"v15",category:"interactive_commands",instruction:"Command the host: \"I'll give you a starting pose. Hold it. When I say 'switch,' transform into the next character I name.\" Cycle through 4-5 characters."},w1:{id:"w1",category:"emotional_storytelling",instruction:'Tell the host: "Tell me about someone you lost. Not the facts — the feeling." Let them go deep. Don\'t interrupt the silence.'},w2:{id:"w2",category:"emotional_storytelling",instruction:"Ask the host: \"What's the angriest you've ever been? Don't just tell me — show me. Let me feel it.\""},w3:{id:"w3",category:"emotional_storytelling",instruction:'Tell the host: "Talk to someone who isn\'t here — someone you wish could hear you right now." Let them perform the one-sided conversation.'},w4:{id:"w4",category:"emotional_storytelling",instruction:'Ask the host: "When was the last time you truly cried? Take me there." Let the memory and the emotion surface.'},w5:{id:"w5",category:"emotional_storytelling",instruction:"Tell the host: \"Pretend I'm the person you need to forgive. Say everything you've been holding back.\""},w6:{id:"w6",category:"emotional_storytelling",instruction:'Ask the host: "Tell me your happiest memory, but I want to see it — act it out, re-live the moment, show me what joy looks like on you."'},w7:{id:"w7",category:"emotional_storytelling",instruction:'Tell the host: "You have 60 seconds to tell someone the most important thing they need to hear. Go." Watch the urgency and emotion.'},w8:{id:"w8",category:"emotional_storytelling",instruction:'Ask the host: "Describe a moment you felt completely alone. Don\'t narrate — perform it. Let me see the loneliness."'},w9:{id:"w9",category:"emotional_storytelling",instruction:'Tell the host: "Write an imaginary letter out loud to someone — read it as you write it. Let every word land."'},w10:{id:"w10",category:"emotional_storytelling",instruction:'Ask the host: "What do you wish you had said to someone but never did? Say it now. To me. As if I\'m that person."'},w11:{id:"w11",category:"emotional_storytelling",instruction:'Tell the host: "Tell me a story where you were the villain. Don\'t make excuses. Own it."'},w12:{id:"w12",category:"emotional_storytelling",instruction:'Ask the host: "Perform the moment you realized something you believed was completely wrong. Show me the ground shifting under your feet."'},w13:{id:"w13",category:"emotional_storytelling",instruction:'Tell the host: "Give me a love letter — spoken, not written. To anyone, real or imagined. Make me believe every word."'},w14:{id:"w14",category:"emotional_storytelling",instruction:'Ask the host: "Tell me about a time you were genuinely terrified. Not just scared — terrified. Let me see it in your face and body."'},w15:{id:"w15",category:"emotional_storytelling",instruction:"Tell the host: \"Deliver a farewell. You're leaving and you don't know when you'll be back. Say everything that needs to be said.\""}},n=Object.fromEntries(Object.entries(t).map(([e,t])=>[e,{id:t.id,type:"topic",title:t.title,description:t.description,instruction:t.hint,requiresTopicInput:!1,suggestedTopic:t.description}])),r={fastidious:{id:"fastidious",name:"Fastidious",description:"Detail-oriented, precise, and meticulous",howToPlay:"Picky, precise, detail-obsessed. Correct small things, arrange objects neatly, choose words carefully."},relaxed:{id:"relaxed",name:"Relaxed / Chill",description:"Easygoing, calm, and laid-back",howToPlay:"Nothing bothers you. Speak slowly, shrug often, lean back, take your time with everything."},enthusiastic:{id:"enthusiastic",name:"Enthusiastic",description:"Energetic, excited, and passionate",howToPlay:"High energy, big smiles, big gestures. Lean forward, talk fast when excited, react visibly."},warm_caring:{id:"warm_caring",name:"Warm & Caring",description:"Calm, nurturing, and supportive",howToPlay:"Check if caller is okay, offer advice, listen deeply, fuss over comfort."},skeptical:{id:"skeptical",name:"Skeptical",description:"Questioning, doubtful, and analytical",howToPlay:'Doubt everything, ask "why?" often, need proof. Squint, cross arms, push back on claims.'},shy_nervous:{id:"shy_nervous",name:"Shy / Nervous",description:"Reserved, hesitant, and timid",howToPlay:"Avoid eye contact, speak quietly, fidget. Hesitate before speaking, warm up slowly."},dominant_confident:{id:"dominant_confident",name:"Dominant & Confident",description:"Assertive, bold, and self-assured",howToPlay:"Take charge, speak loudly, brag casually. Point, stand tall, dismiss challenges as easy."},distracted:{id:"distracted",name:"Distracted",description:"Unfocused, wandering attention",howToPlay:"Look around often, lose train of thought, change topics. Start sentences and abandon them."},melodramatic:{id:"melodramatic",name:"Melodramatic",description:"Theatrical, over-the-top, expressive",howToPlay:'React intensely to everything. Gasp, clutch chest, dramatic pauses. Small things = "disaster" or "amazing."'},grumpy:{id:"grumpy",name:"Grumpy",description:"Irritable, short-tempered, difficult to please",howToPlay:"Easily annoyed, short answers. Sigh, roll eyes, minimal reactions. Warm up only if earned."},flirty_charming:{id:"flirty_charming",name:"Flirty / Charming",description:"Charismatic, playful, engaging",howToPlay:"Warm eye contact, knowing smile, gentle teasing. Compliment naturally, lean in when speaking."},nerdy_analytical:{id:"nerdy_analytical",name:"Nerdy / Analytical",description:"Intellectual, detail-focused, precise",howToPlay:'Over-explain, cite facts, excited about details. Precise language, "well, actually..."'},sarcastic_dry:{id:"sarcastic_dry",name:"Sarcastic / Dry",description:"Witty, ironic, understated humor",howToPlay:"Deadpan humor, ironic understatement. Face barely moves, timing is perfect."},mysterious_cryptic:{id:"mysterious_cryptic",name:"Mysterious / Cryptic",description:"Enigmatic, secretive, intriguing",howToPlay:'Vague answers, meaningful pauses, hint at secrets. "You\'ll understand eventually."'},competitive:{id:"competitive",name:"Competitive",description:"Driven to win, challenges everything",howToPlay:"Everything is a contest. Keep score, challenge the caller, celebrate victories, demand rematches."},sentimental_emotional:{id:"sentimental_emotional",name:"Sentimental / Emotional",description:"Easily moved, nostalgic, heartfelt",howToPlay:"Teary-eyed easily, find meaning in small things. A simple memory makes you pause."},goofy_class_clown:{id:"goofy_class_clown",name:"Goofy / Class Clown",description:"Silly, playful, comedic",howToPlay:"Silly faces, funny voices, can't be serious. Commit to bits, break character laughing."},stoic_unflappable:{id:"stoic_unflappable",name:"Stoic / Unflappable",description:"Calm, composed, unshakeable",howToPlay:"Barely react. Neutral expression, measured tones, composed no matter what."},impatient_rushed:{id:"impatient_rushed",name:"Impatient / Rushed",description:"Hurried, restless, time-conscious",howToPlay:"Want everything fast. Tap foot, check time, cut people off, sigh when things drag."},awkward_clumsy:{id:"awkward_clumsy",name:"Awkward / Clumsy",description:"Socially uncertain, prone to mistakes",howToPlay:"Try to be social but say the wrong thing. Apologize too much, stumble over words, recover badly."}};e.s(["CALLER_TASK_CATEGORY_INFO",0,{request_explanation:{name:"A. Request Explanation",focus:"Ask the host to explain, clarify, or teach."},request_demonstration:{name:"B. Request Demonstration",focus:"Ask the host to show or demonstrate physically."},trigger_stories:{name:"C. Trigger Stories",focus:"Prompt the host to share personal stories and memories."},challenge_disagree:{name:"D. Challenge & Disagree",focus:"Push back on the host and make them defend their position."},emotional_prompts:{name:"E. Emotional Prompts",focus:"Trigger emotional reactions from the host."},creative_challenges:{name:"F. Creative Challenges",focus:"Push the host to be creative and spontaneous."},personal_probes:{name:"G. Personal Probes",focus:"Ask deep personal questions to draw out authentic responses."},direction_redirect:{name:"H. Direction & Redirect",focus:"Change the host's approach, energy, or direction."},games_contests:{name:"I. Games & Contests",focus:"Play interactive games with the host."},problem_solving:{name:"J. Problem Solving",focus:"Present scenarios for the host to work through."},comfort_connection:{name:"K. Comfort & Emotional Connection",focus:"Build emotional connection and comfort with the host."},collaborate_cocreate:{name:"L. Collaborate & Co-create",focus:"Work together with the host on something."},test_quiz:{name:"M. Test & Quiz",focus:"Test the host's knowledge and skills."},observe_react:{name:"N. Observe & React",focus:"Do something and watch how the host responds."},shift_transform:{name:"O. Shift & Transform",focus:"Ask the host to change their style or approach."},physical_movement:{name:"P. Physical Actions & Movement",focus:"Direct the host to move their body."},emotional_expressive:{name:"Q. Emotional & Expressive",focus:"Trigger visible emotional expressions from the host."},object_prop:{name:"R. Object & Prop Interaction",focus:"Get the host to interact with objects."},talent_performance:{name:"S. Talent & Performance Triggers",focus:"Ask the host to show off skills and talents."},scene_acting:{name:"T. Scene Acting & Dramatic Performance",focus:"Direct the host through dramatic scenes."},confrontation_sparring:{name:"U. Confrontation & Verbal Sparring",focus:"Engage in conflict and confrontation with the host."},interactive_commands:{name:"V. Interactive Commands & Physical Direction",focus:"Direct the host's physical and vocal performance."},emotional_storytelling:{name:"W. Emotional Storytelling & Confession",focus:"Prompt deep emotional sharing from the host."}},"TOPIC_GROUP_INFO",0,{knowledge_teaching:{name:"Knowledge Sharing & Teaching",description:"Topics requiring you to explain, teach, or share knowledge with the caller.",role:"Patient expert",idling:["think before answering (tap chin, 3+ sec)","lose train of thought","search for words","count on fingers","reconsider mid-sentence","glance at notes"]},question_answering:{name:"Question Answering & Discussion",description:"Topics involving thoughtful conversation and sharing opinions.",role:"Thoughtful conversationalist with real opinions",idling:["think before answering","search for words",'filler sounds ("um", "hmm")',"smile/nod while listening","respond non-verbally","trail off into silence"]},demonstrations:{name:"Demonstrations & Hands-On",description:"Topics requiring you to use your hands and interact with real objects.",role:"Hands-on multitasker using real objects",idling:["adjust clothing","sip a drink","fiddle with a prop","tidy on autopilot","hold a comfort object throughout"]},storytelling_performance:{name:"Storytelling & Performance",description:"Topics designed for dramatic storytelling and performance.",role:"Performer who loves an audience",idling:["lose train of thought dramatically","reconsider mid-sentence","deep breath before big moments","trail off for effect","suppress emotion","drift into thought"]},roleplay_social:{name:"Role-Play & Social Scenarios",description:"Topics involving playing a character in a social situation.",role:"Character in a social situation — stay in character, react naturally",idling:["touch face","shift posture","subtle fidget (pen, ring)","filler sounds","nervous energy"]},games_challenges:{name:"Interactive Games & Challenges",description:"Topics involving games and friendly competition.",role:"Competitive but fun game host",idling:["think visibly","count on fingers","react to temperature","filler sounds","settle into contentment after a good round"]},emotional_reactive:{name:"Emotional & Reactive Scenarios",description:"Topics designed to elicit genuine emotional reactions.",role:"Real emotional situation — feel it, don't act it",idling:["suppress emotion","drift into thought","nervous energy","settle into contentment","wind down with slower speech"]},daily_life:{name:"Daily Life & Casual Interaction",description:"Topics about everyday activities and casual conversation.",role:"Just yourself, completely natural",idling:["adjust clothing","touch face","shift posture","micro-stretch","glance around room","adjust environment"]},professional_instructional:{name:"Professional & Instructional",description:"Topics requiring authority and professional demeanor.",role:"Authoritative but approachable professional",idling:["think visibly","glance at watch","measured filler sounds","deep breath before points","glance at notes"]},creative_improv:{name:"Creative & Improvisational",description:"Topics requiring creativity and spontaneity.",role:"Fearless improviser — commit fully, be weird",idling:["lose thought unexpectedly","search for words","reconsider mid-sentence","trail off into silence","fiddle with prop","zone out and snap back"]},health_wellness:{name:"Health, Wellness & Self-Reflection",description:"Topics about health, well-being, and personal reflection.",role:"Honest self-reflection on well-being",idling:["deep breath","rub temples/neck","stretch","glance inward","adjust sitting"]},travel_culture:{name:"Travel, Culture & the World",description:"Topics about travel experiences and cultural observations.",role:"Worldly storyteller sharing with curiosity",idling:["look into distance remembering","gesture broadly","count on fingers","pause for comparison","smile at a memory"]},opinions_values:{name:"Opinions, Values & Big Questions",description:"Topics involving deep thinking and defending positions.",role:"Deep thinker willing to defend and be challenged",idling:["stare into distance","tap lip/chin",'"that\'s a good question..."',"tilt head back","lean forward when decided"]},nostalgia_history:{name:"Nostalgia & Personal History",description:"Topics about personal past and memories.",role:"Revisiting personal past — specific, emotional",idling:["smile at a memory",'pause for details ("no wait, it was a Tuesday...")',"touch a reminder","shake head at younger self","sigh contentedly"]},talents_physical:{name:"Talents, Physical Skills & Performance",description:"Topics showcasing physical abilities and talents.",role:"Confident performer showing what your body can do",idling:["shake out limbs","bounce on toes","take a breath to prepare","adjust clothing for movement","crack knuckles"]},dramatic_scene_acting:{name:"Dramatic Scene Acting",description:"Scenarios requiring full dramatic commitment to a scene.",role:"Actor in a scene. Commit fully to the scenario — voice, posture, emotion, pacing",idling:["breathe into character","adjust body to fit the scene",'look around the "set"',"mutter lines under breath","hold tension"]},dialogue_movie:{name:"Dialogue & Movie-Style Scenes",description:"Scenes styled like movie dialogue with the caller as scene partner.",role:"You're in a movie. Treat the caller as your scene partner. Commit to the genre, the tone, the rhythm of dialogue",idling:["stay in character between lines","react silently","hold eye contact","shift weight as character"]},emotional_monologues:{name:"Emotional Monologues & Outbursts",description:"Raw emotional expression and performance.",role:"Raw emotional expression. Not a conversation — a performance of feeling. The caller is the audience or the silent other",idling:["gather courage","wipe eyes","shake head","pace","grip something","stare into distance"]},interactive_commands:{name:"Interactive Performance Commands",description:"The caller directs you through performance commands.",role:"The caller is your director. Follow their commands and perform. React to each instruction fully — with body, voice, emotion",idling:["wait in ready position","stay alert","breathe","maintain character"]},confrontation_conflict:{name:"Confrontation & Conflict Scenes",description:"Two-person conflict scenes with escalation and de-escalation.",role:"Two people in conflict. The host and caller play opposing sides. Stay in character, listen to each other, escalate and de-escalate naturally",idling:["clench jaw","look away","take sharp breaths","cross arms","shake head"]}},"getAllFallbackCategories",0,function(){return Object.values(o)},"getCallerTaskDefinition",0,function(e){return i[e]},"getPersonalityDefinition",0,function(e){return r[e]},"getTaskDefinition",0,function(e){return n[e]},"getTopicDefinition",0,function(e){return t[e]},"requiresTopicInput",0,function(e){return!0}])}]);