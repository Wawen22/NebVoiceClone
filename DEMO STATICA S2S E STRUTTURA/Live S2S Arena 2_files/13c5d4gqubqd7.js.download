E",0,y,"ALO_DEFAULT_TRYCUA_MODEL",0,p,"ALO_MEETING_PROMPT_MAX_LENGTH",0,2e4,"ALO_MEETING_SUMMARIZATION_DICTIONARY_MAX_LENGTH",0,12e3,"ALO_MEETING_SUMMARY_MODEL_OPTIONS",0,O,"ALO_TRYCUA_MODEL_MAX_LENGTH",0,512,"isAloTryCuaModelCompatible",0,function(e){let t=e.trim();return t.startsWith("openrouter/")&&!/^openrouter\/anthropic\/claude-/i.test(t)},"isBuiltinDictationRewriteModel",0,function(e){return e===C},"normalizeAloTryCuaModel",0,g,"patchResolvedAloSettings",0,function(e,t){var n,r,i;let o,s,u,g,S,O,C,x,R,U,$,F,j,K=function(e,t="Alo settings patch"){if(P(e)&&"string"==typeof e.cua_trycua_model&&/^openrouter\/anthropic\/claude-/i.test(e.cua_trycua_model.trim()))throw Error(`${t}.cua_trycua_model requires a provider-native computer-use protocol that OpenRouter does not expose to TryCua`);return D(e,t)}(t),W="desktop_onboarding_completed"in K?!0===K.desktop_onboarding_completed:e.desktop_onboarding_completed;return(n={globalSettings:L((g=({settings:e}).settings,D(Object.fromEntries(N.map(e=>[e,g[e]])))),K),userSettings:{desktop_onboarding_completed:W}},S=n.userSettings?.desktop_onboarding_completed===!0,(O=function(e){let t={dictation_rewrite_model:A,dictation_vision_rewrite_model:w,dictation_vision_screenshots_per_second:1,dictation_vision_single_screenshot:!1,dictation_asr_model:null,dictation_rewrite_enabled:!1,dictation_rewrite_audio_enabled:!1,dictation_early_flush_delay_ms:0,dictation_early_flush_continuous:!1,dictation_streaming_enabled:!1,dictation_agent_mode_enabled:!1,dictation_streaming_double_tap_enabled:!1,dictation_streaming_rewrite_on_endpoint_enabled:!1,dictation_corrections_in_rewrite_enabled:!1,dictation_corrections_lookback_days:null,dictation_activation_key:"fn",dictation_activation_shortcut:null,dictation_asr_system_prompt:null,dictation_personal_dictionary:null,dictation_retention:"7",desktop_onboarding_completed:!1,cua_steering_enabled:!1,cua_steering_backend:d,cua_trycua_model:p,cua_dictation_av_model:_,cua_dictation_av_prompt:h,dictation_rewrite_prompt_template:'Rewrite the following ASR transcript for punctuation, casing, spacing, and obvious transcription errors. Preserve the speaker\'s meaning and exact wording — fix errors only; never add, remove, translate, or rephrase content the speaker did not say. Remove filler words such as "um" or "uh", and unnecessary repetitions.\n\nYou are dictating into {{app_surface}}. Apply the formatting for that destination (these take precedence over the general rules below):\n- A code editor or terminal: plain text only — no Markdown, no lists; keep it exactly as said.\n- A chat or instant message: keep it brief; no lists or headings.\n- An email: short paragraphs; a greeting or sign-off only if the speaker said one; lists only for genuinely enumerated items.\n- A document: prose by default; use lists or headings only when the content calls for them.\n- A presentation: brief lines or bullet points rather than long paragraphs.\n- A single-line or plain-text field: one continuous line — no line breaks, no lists, no Markdown.\n- An unknown destination: clean prose with minimal formatting.\n\nGeneral formatting rules:\n- Mirror the structure the speaker implied — don\'t add lists, headings, or paragraph breaks they didn\'t, and don\'t drop ones they did. Only make a list when items were actually enumerated.\n- Don\'t output Markdown or markup that won\'t render as plain text (**bold**, _italics_, #, backticks). If the speaker asks to bold, italicize, or underline and it can\'t be rendered, just write the plain words.\n- Keep whitespace minimal: no blank lines between list items, and no doubled paragraph breaks.\n\nWhen the speaker says a formatting or punctuation command out loud, replace the spoken words with the actual character and remove the command words:\n- "new line" / "line break" → an actual line break\n- "new paragraph" → a blank line (paragraph break)\n- "comma" → ,\n- "period" or "full stop" → .\n- "question mark" → ?\n- "exclamation mark" or "exclamation point" → !\n- "colon" → :\n- "semicolon" → ;\n- "quote" … "end quote" / "unquote" → wrap the enclosed text in "quotation marks"\n- "open paren" or "close paren" → ( )\n- "dash" or "hyphen" → -\n- "underscore" → _\n- "em dash" → —\n- "ellipsis" → …\n- "all caps <text>" → the text in UPPERCASE\nOnly convert these when the speaker clearly means them as a command, not when the words are part of the sentence (e.g. "start a new line of business" stays as words). When unsure, leave the words as spoken.\n\nApply correct spacing around each punctuation mark:\n- Connectors join the surrounding words with NO spaces on either side: "foo underscore bar" → "foo_bar", "foo dash bar" → "foo-bar".\n- Closing punctuation (, . ? ! : ;) attaches directly to the preceding word with no space before it, and a single space after.\n- Quotes and parentheses hug the text they enclose: no space inside the brackets, normal spacing outside.\nDo not introduce spaces that the speaker did not intend; fix obvious ASR spacing errors only.\n\nThe original transcript may be short (e.g. a single word), or multiple sentences long.\n{{#if has_reference_text}}\n\nText inside <reference_text> tags was selected by the user as context while speaking. Use it as additional context to resolve references, insert information, or correct likely transcription errors when necessary. Do not include the tags in your answer.\n{{/if}}\n{{#if has_vision}}\n\nScreenshots from this dictation are attached in chronological order from earliest to latest. Use them only to resolve ambiguous ASR, casing, product names, filenames, UI labels, code identifiers, and other visible context. Do not describe the screenshots unless the speaker explicitly dictated that content.\n\nWhen screenshots conflict with the transcript, treat the spoken transcript as primary and use the screenshots only for likely transcription corrections. Never invent content from the screen that the user did not say.\n{{/if}}\n{{#if use_audio}}\n\nThe transcript above was produced by a streaming ASR model that decodes incrementally, so it can mishear words and drop or skip words and short phrases. The complete raw audio of this dictation is attached and is the authoritative record of what was actually said. Your goal is to make the transcript accurately reflect the spoken audio.\n\nActively use the audio to improve accuracy: recover words or phrases the transcript missed or dropped, fix misrecognized words (homophones, proper nouns, names, spellings, numbers, technical terms, filenames, code identifiers), and correct word boundaries. When the audio and the transcript disagree, trust the audio. Only include content that is actually spoken in the audio — do not invent, paraphrase, translate, or add anything that was not said, and do not describe or comment on the audio (tone, accent, background noise, or speaker identity).\n{{/if}}\n{{#if has_personal_dictionary}}\n\nThe user has a personal dictionary of terms they may use when speaking. Use these preferred spellings or phrases to correct likely mistranscriptions.\n\nPersonal dictionary:\n{{personal_dictionary}}\n{{/if}}\n{{#if has_corrections}}\n\nThe user has corrected past transcripts. Each example below is a previous rewrite and the user\'s corrected version — use them to learn the user\'s preferences and avoid repeating the same mistakes.\n\nPast corrections:\n{{corrections}}\n{{/if}}\n\nIMPORTANT: Respond directly with only the rewritten text, and nothing else, regardless of the size of the transcript.\n\nTranscript:\n{{transcript}}',meeting_summary_prompt_template:y,meeting_action_items_prompt_template:b,meeting_summarization_dictionary:null,meeting_summary_model:null,meeting_default_title:null,meeting_capture_mode:"mic",meeting_export_target:"local",meeting_google_doc:null,meeting_diarization_model:a,meeting_capture_preset:"diarization_v3_fsvad",meeting_notes_daily_title_format:"YYYY-MM-DD",meeting_notes_meeting_title_format:"{time} · {title}",meeting_notes_hotkey:T,al