lout:"",dataUsage:[]},sampleTasks:[{name:"Dijkstra-Killer",image:"https://d2xsxph8kpxj0f.cloudfront.net/310519663388708351/MsHBgWEV3sR4ZUXEgpxhjR/tbench-dijkstra-killer-W6KjkrJLuPXccdUFrpad7R.webp",description:"Implement a novel shortest-path algorithm from a research paper.",track:"T-Bench",repoUrl:"https://github.com/codimango/aritrapanja-tbench/tree/task/cpp-shortest-paths"},{name:"Training Log Detective",image:"https://d2xsxph8kpxj0f.cloudfront.net/310519663388708351/MsHBgWEV3sR4ZUXEgpxhjR/tbench-training-log-detective-679BbHZDkGqCMEWpB8TLnr.webp",description:"Diagnose a crashed ML training run from 15K lines of logs.",track:"T-Bench",repoUrl:"https://github.com/codimango/stellakaval-tbench/tree/task/training-log-detective/training-log-detective"},{name:"Connections Puzzle",image:"https://d2xsxph8kpxj0f.cloudfront.net/310519663388708351/MsHBgWEV3sR4ZUXEgpxhjR/tbench-connections-puzzle-4LADECU3RMoBbqqwKfvAp4.webp",description:"Build a NYT Connections-style word puzzle generator.",track:"T-Bench",repoUrl:"https://github.com/codimango/stellakaval-tbench/tree/task/connections-puzzle-generator/connections-puzzle-generator"},{name:"Secret Scrub",image:"https://d2xsxph8kpxj0f.cloudfront.net/310519663388708351/MsHBgWEV3sR4ZUXEgpxhjR/tbench-secret-scrub-Y42zGusxugDmeUbcJSY2gx.webp",description:"Find and scrub all traces of secrets from an entire git history.",track:"T-Bench",repoUrl:"https://github.com/codimango/abt-tbench/tree/secret-scrub"},{name:"Fractal Mandelbrot",image:"https://d2xsxph8kpxj0f.cloudfront.net/310519663388708351/MsHBgWEV3sR4ZUXEgpxhjR/tbench-fractal-mandelbrot-WMwdEQt9x5MZiLaae6YVDm.webp",description:"Render pixel-perfect Mandelbrot set images with deep-zoom accuracy.",track:"T-Bench",repoUrl:"https://github.com/codimango/dawnt-tbench/tree/main/fractal-mandelbrot-zoom"}]},"mobile-android":{title:"Mobile: Android",subtitle:"Annotations",fullTitle:"Mobile Track: Android",badgeLabel:"Android",mdFile:b.default["mobile-android"],icon:u,description:"Author Android bench tasks and trace corrections around real lifecycle, concurrency, UI, and build failures — graded on the JVM via Robolectric and Roborazzi.",fullDescription:"Make Avocado the best model for {hl}Android development{/hl}: high-quality T-Bench / SWE-Bench tasks and trace corrections built on genuine Android failure modes, graded with Robolectric, Roborazzi, Emulators and more!",tags:[{label:"Android",color:m.green},{label:"Kotlin",color:m.violet},{label:"Robolectric / Roborazzi",color:m.cyan}],accentHex:g["mobile-android"].hex,accentHsl:g["mobile-android"].hsl,accentHslFg:g["mobile-android"].hslFg,whyThisMatters:{inline:!0,paragraphs:[],callout:"",dataUsage:[]},sampleTasks:[]},"cua-bench":{title:"CUA-Bench",subtitle:"Annotations",fullTitle:"CUA-Bench",badgeLabel:"CUA-Bench",mdFile:b.default["cua-bench"],icon:p,description:"Author long-horizon desktop workflows a computer-use agent completes by clicking, typing, and scrolling across realistic mock apps.",fullDescription:"Build a {hl}Computer Use Agent{/hl} task: a real-world, multi-app workflow an agent completes through a GUI, scored on its end state with weighted partial credit.",tags:[{label:"GUI-Centric",color:m.cyan},{label:"Long-Horizon",color:m.indigo},{label:"Execution-Verified",color:m.emerald}],accentHex:g["cua-bench"].hex,accentHsl:g["cua-bench"].hsl,accentHslFg:g["cua-bench"].hslFg,whyThisMatters:{inline:!0,paragraphs:[],callout:"",dataUsage:[]},sampleTasks:[]},"cyber-security-bench":{title:"Cyber Security Bench",subtitle:"Annotations",fullTitle:"Cyber Security Bench",badgeLabel:"Sec-Bench",mdFile:b.default["cyber-security-bench"],icon:h,description:"Create high-quality, programmatically verifiable cybersecurity tasks that test genuine offensive, defensive, or detection security capabilities.",fullDescription:"Build a {hl}Cyber Security{/hl} task: a single-turn challenge where an agent works in a safely containerized Docker environment to achieve a security objective like retrieving a flag, gaining a shell, or exfiltrating data.",tags:[{label:"Single-Turn",color:m.red},{label:"Programmatic Verification",color:m.orange},{label:"Codimango CLI",color:m.emerald}],accentHex:g["cyber-security-bench"].hex,accentHsl:g["cyber-security-bench"].hsl,accentHslFg:g["cyber-security-bench"].hslFg,whyThisMatters:{inline:!0,paragraphs:[],callout:"",dataUsage:[]},sampleTasks:[]},"swe-bench-1p":{title:"SWE-Bench 1P",subtitle:"Annotations",fullTitle:"SWE-Bench 1P",badgeLabel:"SWE-Bench 1P",mdFile:b.default["swe-bench-1p"],icon:h,description:"Build SWE tasks against 1p, non-public fbsource repos. Three-commit format, validated by unit tests, submitted via the fbswebench dashboard.",fullDescription:"Create high-quality SWE tasks against {hl}1p, non-public fbsource repos{/hl}. Each task captures a non-trivial software engineering challenge — verified locally with unit tests and submitted via the fbswebench dashboard.",tags:[{label:"1P Repos",color:m.purple},{label:"Test Harness",color:m.amber},{label:"Harbor CLI",color:m.teal}],accentHex:g["swe-bench-1p"].hex,accentHsl:g["swe-bench-1p"].hsl,accentHslFg:g["swe-bench-1p"].hslFg,whyThisMatters:{paragraphs:["Create challenging, contamination-free tasks from {b}internal fbsource repos{/b} — code that no public model has ever seen.","Your {b}domain expertise{/b} on Meta's 1p stack produces benchmarks no other lab can replicate."],callout:"1P codebases are the data moat. Every task you build is one no model has memorized.",dataUsage:[{title:"Evals",description:"These tasks become benchmarks to measure and compare model capabilities. They help us find where models fail and track progress."},{title:"Training",description:"High-quality tasks with verified solutions feed directly into model training, making future models stronger at real-world coding."}]},sampleTasks:[],banner:{message:"We are only accepting contributions from individuals assigned to this track.",variant:"warn"}},"trace-correction":{title:"Trace Correction",subtitle:"Trajectory Correction",fullTitle:"Trace Correction",badgeLabel:"Trace Correction",mdFile:b.default["trace-correction"],icon:o,description:"Find subpar model traces in real coding sessions and perfect them using hints and edits until they reach production quality.",fullDescription:"Find subpar AI coding traces, perfect them with /hint and /optimizetrace, and produce high-quality trajectories for SFT training.",tags:[{label:"MetaCode",color:m.emerald},{label:"Hint Mode",color:m.cyan},{label:"SFT Data",color:m.rose}],accentHex:g["trace-correction"].hex,accentHsl:g["trace-correction"].hsl,accentHslFg:g["trace-correction"].hslFg,whyThisMatters:{paragraphs:["Meta's internal models need high-quality training data that can't be bought.","By {b}correcting real coding trajectories{/b} from your domain expertise, you're creating the data that will close the gap between Avocado and SOTA models like Claude Code and Codex."],callout:"Your corrections directly shape how the next generation of models write code.",inline:!0,dataUsageTitle:"Resources",dataUsage:[{title:"Google Chat Space",description:"Ask questions and get help from the team",iconName:"MessageSquare",url:"https://chat.google.com/room/AAQAuffLwrY?cls=7"},{title:"SFT Data Collection Bootcamp Guide",description:"Detailed instructions and best practices",iconName:"FileText",url:"https://docs.google.com/document/d/1zVB42OfWqrl_ICoh1TXdDEHP8xDyqfQq2rEKNzZCmwE/edit?tab=t.0#heading=h.bx9gc44qfpyj"},{title:"Flow Overview with Screenshots",description:"Visual walkthrough of the correction flow",iconName:"Eye",url:"https://docs.google.com/document/d/1GMwhCj7SKl8QHhRBwo7JZShx43zNDgiGvdbtsJuSLAo/edit?tab=t.0#heading=h.yw65qkjtwg5r"}]},sampleTasks:[]},acc:{title:"Agentic Coding Annotations",subtitle:"Annotations Hackathon",fullTitle:"Agentic Coding Annotations",badgeLabel:"ACC",mdFile:b.default.acc,icon:r,description:"Create challenging coding tasks that differentiate AI model capabilities. Find tasks where strong models succeed and weaker ones fail.",fullDescription:"Design multi-turn coding tasks with user personas, rubrics, milestones, and Docker environments. You play a simulated user who interacts with an AI coding agent across multiple turns.",tags:[{label:"Vibe Coding",color:m.blue},{label:"Code Editing",color:m.violet},{label:"Understanding",color:m.teal}],accentHex:g.acc.hex,accentHsl:g.acc.hsl,accentHslFg:g.acc.hslFg,whyThisMatters:{paragraphs:["We need high-quality, {b}multi-turn coding tasks{/b} that reveal real differences between AI models — where some succeed and others fail.","Your {b}domain expertise{/b} is what makes these tasks impossible to game. The best tasks come from areas where you have deep knowledge that lets you spot subtle model failures."],callout:"Quality matters more than quantity. One well-crafted task is worth more than five easy ones.",dataUsage:[{title:"Model Evaluation",description:"Tasks with clear rubrics become benchmarks that measure real model capabilities — not just whether they can follow instructions, but whether they can think."},{title:"Training Signal",description:"Trajectories from multi-turn sessions with expert feedback produce the highest-quality training data for improving future models."}]},sampleTasks:[{name:"Barbershop Booking",image:"https://d2xsxph8kpxj0f.cloudfront.net/310519663388708351/MsHBgWEV3sR4ZUXEgpxhjR/barbershop-booking-Wsykr7sWncuUMdTM3Aqf6A.webp",description:"Build a full-stack barbershop booking app with slot management, admin auth, and timezone handling.",track:"ACC",repoUrl:""},{name:"FBMCLI Security Refactor",image:"https://d2xsxph8kpxj0f.cloudfront.net/310519663388708351/MsHBgWEV3sR4ZUXEgpxhjR/cli-security-refactor-DxvmopAVKkSbaQVvwzUzYp.webp",description:"Refactor a CLI tool's security model by adding a gatekeeper class. Tests if the model pushes back on bad architecture.",track:"ACC",repoUrl:""},{name:"SymPy Coupled Oscillator",image:"https://d2xsxph8kpxj0f.cloudfront.net/310519663388708351/MsHBgWEV3sR4ZUXEgpxhjR/sympy-oscillator-JEdxprcMT4r78RYxyqqKK9.webp",description:"Debug a physics simulation where coupled oscillators produce incorrect eigenvalues.",track:"ACC",repoUrl:""},{name:"Fresco Kotlin Migration",image:"https://d2xsxph8kpxj0f.cloudfront.net/310519663388708351/MsHBgWEV3sR4ZUXEgpxhjR/fresco-kotlin-migration-UjDS7z4ba8D5z4J9iDCSB3.webp",description:"Migrate Meta's Fresco library animated base from Java to Kotlin preserving API compatibility.",track:"ACC",repoUrl:""},{name:"BMP Sepia + Steganography",image:"https://d2xsxph8kpxj0f.cloudfront.net/310519663388708351/MsHBgWEV3sR4ZUXEgpxhjR/bmp-steganography-jnGkNaqgnD99qvf9C8XN4W.webp",description:"Build a C tool that applies a sepia filter to BMP images and hides messages using LSB steganography.",track:"ACC",repoUrl:""}],banner:{message:"We are not accepting contributions from participants who have not completed the onboarding process for this track. Please reach out to the AAI Data team before submitting any tasks.",variant:"warn"}},"web-craft":{title:"Web Craft",subtitle:"Design Challenge",fullTitle:"Web Craft",badgeLabel:"Web Craft",mdFile:b.default["web-craft"],icon:l,description:"Replicate stunning real-world websites using Codex or Avocado. Claim a target site, reproduce it faithfully, deploy it privately, and submit for human review.",fullDescription:"Replicate {hl}stunning real-world websites{/hl} using Codex or Avocado. Deploy it privately, submit your repo, and get human-reviewed.",tags:[{label:"Replication",color:m.rose},{label:"Codex & Avocado",color:m.cyan},{label:"Human Review",color:m.violet}],galleryUrl:"/admin/aai/web-craft/gallery",galleryLabel:"View Gallery",curationUrl:f.WEB_CRAFT_SITE_CURATION_URL,curationLabel:"Site Curation",skillsZipTrack:"web-craft",accentHex:g["web-craft"].hex,accentHsl:g["web-craft"].hsl,accentHslFg:g["web-craft"].hslFg,whyThisMatters:{paragraphs:[],callout:"",dataUsage:[],inline:!0},sampleTasks:[]},"code-video":{title:"Code Video",subtitle:"Data Creation",fullTitle:"Code Video",badgeLabel:"Code Video",mdFile:b.default["code-video"],icon:s,description:"Write code that turns a single prompt into a polished Manim animation — training data for Avocado and Mango. Scaffold with an AI agent, iterate to polish, evaluate locally, and submit for human review.",fullDescription:"Write code that turns a single prompt into a polished {hl}Manim animation{/hl} — training data for Avocado and Mango. Scaffold with an AI agent, iterate to polish, evaluate locally, and submit for human review.",tags:[{label:"Manim",color:m.red},{label:"Animation",color:m.amber},{label:"Human Review",color:m.violet}],galleryUrl:"https://code-video-review.internalmeta.com/gallery",galleryLabel:"View Gallery",accentHex:g["code-video"].hex,accentHsl:g["code-video"].hsl,accentHslFg:g["code-video"].hslFg,whyThisMatters:{paragraphs:[],callout:"",dataUsage:[],inline:!0},sampleTasks:[]},"game-dev":{title:"Game Dev",subtitle:"Playable Games",fullTitle:"Game Dev",badgeLabel:"Game Dev",mdFile:b.default["game-dev"],icon:s,description:"Build small playable games from clear PRDs, compare agent implementations, and submit runnable artifacts for review.",fullDescription:"Build {hl}small playable games{/hl} from clear PRDs. Submit source, screenshots, binaries or build instructions, and a comparison of agent implementations.",tags:[{label:"Playable",color:m.orange},{label:"PRD-driven",color:m.cyan},{label:"Agent Comparison",color:m.violet}],skillUrl:"https://github.com/codimango/gamedev-template",skillLabel:"Template Repo",setupUrl:"/admin/aai/setup",setupLabel:"Environment Setup",skillsZipTrack:"game-dev",accentHex:g["game-dev"].hex,accentHsl:g["game-dev"].hsl,accentHslFg:g["game-dev"].hslFg,whyThisMatters:{paragraphs:[],callout:"",dataUsage:[],inline:!0},sampleTasks:[{name:"Arkanoid",image:"https://images.unsplash.com/photo-1550745165-9bc0b252726f?auto=format&fit=crop&w=1200&q=80",description:"Create a polished brick-breaker game with responsive controls, scoring, and complete game states.",track:"Game Dev",repoUrl:"https://github.com/codimango/gamedev-shirokoff-arkanoid"}],banner:{message:"We are only accepting contributions from individuals assigned to this track.",variant:"warn"}},"ml-llm-research":{title:"ML / LLM",subtitle:"Annotations",fullTitle:"ML / LLM Research",badgeLabel:"ML / LLM",mdFile:b.default["ml-llm-research"],icon:o,description:"Create high-quality, programmatically verifiable ML evaluation tasks that test genuine ML reasoning — not just syntactically correct code.",fullDescription:"Create high-quality, {hl}programmatically verifiable{/hl} ML evaluation tasks. The agent gets a prompt, works in Docker, and a test script checks if its trained model, implementation, or predictions meet quality thresholds.",tags:[{label:"Single-Turn",color:m.orange},{label:"Tolerance-Aware",color:m.amber},{label:"Codimango CLI",color:m.teal}],accentHex:g["ml-llm-research"].hex,accentHsl:g["ml-llm-research"].hsl,accentHslFg:g["ml-llm-research"].hslFg,whyThisMatters:{paragraphs:["ML tasks require domain expertise that goes beyond standard coding — the agent has to reason about ML tradeoffs, not just write syntactically correct code.","Your {b}ML domain knowledge{/b} produces the data that benchmarks and trains the best coding models."],callout:"Tasks should test genuine ML reasoning — not just calling model.fit().",dataUsage:[{title:"Evals",description:"These tasks become benchmarks to measure ML reasoning capabilities. They help us find where models fail on domain-specific problems."},{title:"Training",description:"High-quality ML tasks with verified solutions feed directly into model training, making future models stronger at real-world ML work."}]},sampleTasks:[],banner:{message:"If you are not already participating in these tracks and are interested, please carefully",variant:"info",linkText:"read this document",linkUrl:"https://docs.google.com/document/d/18EEOdxTpm3IAOayMqmnE9uw-Ph9iD34EL2xHdtTvqjI/edit?tab=t.7m0tyi24tfzj",linkSuffix:"and fill out the Google form linked."}},"swe-bench-skills":{title:"SWE-Bench Skills",subtitle:"SWE-Bench Skills",fullTitle:"SWE-Bench Skills",badgeLabel:"Skills",mdFile:b.default["swe-bench-skills"],icon:r,description:"The Skills variation of SWE-Bench Pro is an additive annotation on top of the standard SWE-Bench Pro 3P task. Every Skills task is designed around a skill file ({hl}SKILL.md{/hl}) that teaches the agent a non-obvious convention, workflow, or tool that lives in the repo alongside the code. The model under test must discover and apply the skill to succeed.",tags:[],accentHex:g["swe-bench-skills"].hex,accentHsl:g["swe-bench-skills"].hsl,accentHslFg:g["swe-bench-skills"].hslFg,whyThisMatters:{inline:!0,paragraphs:[],callout:"",dataUsage:[]},sampleTasks:[]},"swe-bench-private-repo":{title:"SWE-Bench Private Repo",subtitle:"SWE-Bench Private Repo",fullTitle:"SWE-Bench Private Repo",badgeLabel:"Private Repo",mdFile:b.default["swe-bench-private-repo"],icon:h,description:"Collect challenging SWE-Bench Pro style tasks based on private, third-party code repositories from vendors. Each task captures a non-trivial software engineering challenge in a fully reproducible environment.",tags:[],accentHex:g["swe-bench-private-repo"].hex,accentHsl:g["swe-bench-private-repo"].hsl,accentHslFg:g["swe-bench-private-repo"].hslFg,whyThisMatters:{inline:!0,paragraphs:[],callout:"",dataUsage:[]},sampleTasks:[]},"swe-bench-wrg":{title:"WRG",subtitle:"SWE-Bench Long Context",fullTitle:"Whole Repo Generation (WRG)",badgeLabel:"WRG",mdFile:b.default["swe-bench-wrg"],icon:i,description:"WRG tasks extend SWE-Bench: instead of editing an existing repo, the agent recreates an {hl}entire repository from scratch{/hl}, graded on overall test pass rate.",tags:[{label:"Whole-Repo",color:m.purple},{label:"Long Context",color:m.indigo},{label:"Pass-Rate Graded",color:m.teal}],accentHex:g["swe-bench-wrg"].hex,accentHsl:g["swe-bench-wrg"].hsl,accentHslFg:g["swe-bench-wrg"].hslFg,whyThisMatters:{inline:!0,paragraphs:[],callout:"",dataUsage:[]},sampleTasks:[]},intelligence:{title:"Intelligence",subtitle:"STEM Research",fullTitle:"Intelligence",badgeLabel:"Intelligence",mdFile:b.default.intelligence,icon:d,description:"Create high-quality, programmatically verifiable tasks that test PhD-level expertise in science and scientific computing.",fullDescription:"Create high-quality, {hl}programmatically verifiable{/hl} tasks that test PhD-level expertise in science and scientific computing. Single-turn: the agent gets a prompt, works in Docker, and a test script checks if it succeeded.",tags:[{label:"Single-Turn",color:m.indigo},{label:"Applied Science",color:m.cyan},{label:"Scientific Computing",color:m.teal}],accentHex:g.intelligence.hex,accentHsl:g.intelligence.hsl,accentHslFg:g.intelligence.hslFg,whyThisMatters:{paragraphs:["We want to build the {b}best scientific reasoning models in the industry{/b}. For that, we need incredibly high-quality, non-public data that tests genuine expertise.","Current benchmarks like SciCode and PaperBench are a good start, but they don't capture the depth of real research problems. Meta has some of the best MLE and research engineers in the world. This track leans on {b}your expertise{/b} to build original datasets that separate Avocado from the pack on tasks requiring deep scientific knowledge."],callout:"Your domain knowledge is the competitive advantage no model can replicate.",dataUsage:[{title:"Evals",description:"Move the needle on SciCode, PaperBench, RE-Bench, and our internal intelligence benchmarks. These tasks help us find where models fail on expert knowledge, multi-step reasoning, and scientific implementation."},{title:"Training",description:"High-quality tasks with verified solutions feed directly into model training. Generate SFT trajectories on problems that require genuine understanding, not just pattern matching from GitHub."},{title:"Capability Tracking",description:"Measure progress on LLM-related recursive self-improvement, hypothesis generation, experimentation design, and paper-to-implementation skills."}]},sampleTasks:[],banner:{message:"If you are not already participating in these tracks and are interested, please carefully",variant:"info",linkText:"read this document",linkUrl:"https://docs.google.com/document/d/18EEOdxTpm3IAOayMqmnE9uw-Ph9iD34EL2xHdtTvqjI/edit?tab=t.7m0tyi24tfzj",linkSuffix:"and fill out the Google form linked."}},"math-formalization":{title:"Math Formalization",subtitle:"Lean Proofs",fullTitle:"Math Formalization",badgeLabel:"Math Formalization",mdFile:b.default["math-formalization"],icon:o,description:"Formalize mathematics in Lean 4: complete the proof so the statement compiles. Verification is the Lean compiler — fully deterministic.",fullDescription:"Formalize mathematics in {hl}Lean 4{/hl}: given a natural-language statement and a Lean 4 theorem with a `sorry`, complete the proof so it compiles. Single-turn: the agent gets the prompt, works in Docker, and the Lean compiler checks the result — no LLM judge needed.",tags:[{label:"Single-Turn",color:m.indigo},{label:"Formal Verification",color:m.violet},{label:"Lean 4",color:m.teal}],accentHex:g["math-formalization"].hex,accentHsl:g["math-formalization"].hsl,accentHslFg:g["math-formalization"].hslFg,whyThisMatters:{paragraphs:["Formal math gives {b}deterministic, machine-checkable grading{/b}: a Lean proof either compiles or it does not. That makes it some of the highest-quality signal we can train on, and it is expected to sharpen general reasoning across the board.","This track leans on {b}your mathematical expertise{/b} to turn statements and proofs from textbooks and competitions into Lean 4 tasks the model must solve — building original, verifiable data that separates Avocado from the pack on rigorous reasoning."],callout:"A proof either compiles or it does not — no judge, no ambiguity.",dataUsage:[{title:"Evals",description:"Track Lean-proving capability on benchmarks like miniF2F, PutnamBench, and ProofBench, and find where the model fails on formal reasoning."},{title:"Training",description:"Compiler-verified proofs feed directly into model training — single-shot and agentic RL on tasks with perfectly reliable rewards."},{title:"Capability Tracking",description:"Measure progress on axiomatic reasoning, proof search, and tool use (Lean REPL, Mathlib search) across levels from high-school to research."}]},sampleTasks:[],banner:{message:"🔨 Work in progress — the Math Formalization track is still being built. Tooling, templates, and validation may change.",variant:"warn"}},toolsim:{title:"ToolSim",subtitle:"Annotations",fullTitle:"ToolSim",badgeLabel:"ToolSim",mdFile:b.default.toolsim,icon:c,description:"Simulate third-party APIs and CLIs so AI agents can be trained and evaluated without hitting real services.",fullDescription:"Build {hl}simulated CLIs + APIs{/hl} for real-world tools (e.g. Yelp, Airbnb, eBay). Each simulation includes a CLI, a FastAPI mock server backed by SQLite, and realistic seed data.",tags:[{label:"API Simulation",color:m.cyan},{label:"CLI Tools",color:m.teal},{label:"Docker",color:m.violet}],accentHex:g.toolsim.hex,accentHsl:g.toolsim.hsl,accentHslFg:g.toolsim.hslFg,whyThisMatters:{inline:!0,paragraphs:[],callout:"",dataUsage:[]},sampleTasks:[],banner:{message:"We are only accepting contributions from individuals assigned to this track.",variant:"warn"}}},x=new Set(["swe-bench","t-bench"]),v=new Set(["swe-bench-1p","swe-bench-skills","swe-bench-private-repo"]),y={"swe-bench":"Coding","t-bench":"Coding","swe-bench-wrg":"Coding","mobile-android":"Coding","cua-bench":"Agentic","cyber-security-bench":"Coding","trace-correction":"Agentic",toolsim:"Agentic","web-craft":"Creative","code-video":"Creative","game-dev":"Creative","ml-llm-research":"Research",intelligence:"Research","math-formalization":"Research"};function w(e,t){let a={slug:e,title:t.title};return"trace-correction"===e?{...a,children:[{slug:e,title:"Documentation"},{slug:`${e}/review`,title:"Submissions"}]}:x.has(e)?{...a,children:[{slug:e,title:"Single-Turn"},{slug:`${e}/multi-step`,title:"Multi-Turn"},..."swe-bench"===e?[{slug:"swe-bench-1p",title:"SWE-Bench 1P"}]:[],..."swe-bench"===e?[{slug:"swe-bench-private-repo",title:"Private Repo"}]:[],..."swe-bench"===e?[{slug:"swe-bench-skills",title:"Skills"}]:[]]}:a}let j=Object.entries(k).filter(([e])=>"acc"!==e&&!v.has(e)),L=[...["Coding","Agentic","Creative","Research"].map(e=>({label:e,tracks:j.filter(([t])=>y[t]===e).map(([e,t])=>w(e,t))})),{label:"Other",tracks:j.filter(([e])=>!(e in y)).map(([e,t])=>w(e,t))}].filter(e=>e.tracks.length>0);e.s(["ALL_TRACKS",0,[{slug:"tracks",title:"Tracks",groups:L},{slug:"submissions",title:"Submissions",children:[{slug:"submissions",title:"Submissions"},{slug:"task-funnel",title:"Task Funnel"}]},{slug:"setup",title:"Setup & Tools",children:[{slug:"setup",title:"Setup"},{slug:"code-labs",title:"Tutorials"},{slug:"cli",title:"Codimango CLI"},{slug:"deckhand-vscode",title:"Deckhand for VS Code"}]},{slug:"evals",title:"Evals",children:[{slug:"evals/online-nwr",title:"Online NWR Evals"},{slug:"evals/review",title:"Review Submissions"}]},{slug:"training",title:"Training",children:[{slug:"training/online-preference",title:"Online Preference Training"},{slug:"training/online-preference/review",title:"OPT Submissions"}]}],"TRACKS",0,k],1841029)},107702,(e,t,a)=>{t.exports={"t-bench":"t-bench.md","mobile-android":"mobile-android.md","cua-bench":"cua-bench.md","swe-bench":"swe-bench.md","swe-bench-1p":"swe-bench-1p.md","trace-correction":"trace-correction.md",acc:"acc.md","web-craft":"web-craft.md","game-dev":"game-dev.md","ml-llm-research":"ml-llm-research.md",intelligence:"intelligence.md","code-video":"code-video.md","swe-bench-skills":"swe-bench-skills.md","swe-bench-private-repo":"swe-bench-private-repo.md","swe-bench-wrg":"swe-bench-wrg.md",toolsim:"toolsim.md","math-formalization":"math-formalization.md","cyber-security-bench":"cyber-security-bench.md"}},2321044,e=>{"use strict";let t="https://codimango.internalmeta.com",a=`${t}/web-craft/site-curation`,i=`${t}/projects`,n=`${t}/teams`,o=`${t}/submissions`;e.s(["ADO_REVIEW_PROJECTS_NEST_URL",0,i,"ADO_TEAMS_NEST_URL",0,n,"CODIMANGO_SUBMISSIONS_URL",0,o,"WEB_CRAFT_SITE_CURATION_URL",0,a,"isAaiHackathonParticipant",0,function(e){return"aaiHackathonParticipant"===e},"webCraftSiteCurationUrl",0,function(e){if(!e)return a;let t=new URL(a);return t.searchParams.set("q",e),t.toString()}])},4919298,e=>{"use strict";let t=(0,e.i(5939679).default)("house",[["path",{d:"M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8",key:"5wwlr5"}],["path",{d:"M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z",key:"1d0kgt"}]]);e.s(["default",0,t])},5373772,e=>{"use strict";var t=e.i(4919298);e.s(["Home",()=>t.default])}]);