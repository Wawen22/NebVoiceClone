<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<style>
* { box-sizing: border-box; margin: 0; padding: 0; }
html, body { height: 100%; overflow: hidden; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: ${r}; color: #eee; }
.slide-container { height: 100%; display: flex; flex-direction: column; }
.slides { flex: 1; position: relative; overflow: hidden; }
.slide { position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: center; align-items: center; padding: 40px 60px; opacity: 0; transition: opacity 0.4s ease, transform 0.4s ease; transform: translateX(40px); pointer-events: none; text-align: center; }
.slide.active { opacity: 1; transform: translateX(0); pointer-events: auto; }
.slide.exit-left { opacity: 0; transform: translateX(-40px); }
.slide-img { padding: 0; }
.slide-img img { width: 100%; height: 100%; object-fit: contain; }
.slide-content { position: relative; width: 100%; }
.slide h1 { font-size: 2.2em; margin-bottom: 0.4em; color: #fff; font-weight: 700; }
.slide h2 { font-size: 1.6em; margin-bottom: 0.4em; color: #fff; font-weight: 600; }
.slide h3 { font-size: 1.3em; margin-bottom: 0.3em; color: #ddd; }
.slide h4 { font-size: 1.1em; margin-bottom: 0.3em; color: #ccc; }
.slide p { font-size: 1em; line-height: 1.6; margin-bottom: 0.5em; color: #ccc; }
.slide ul, .slide ol { text-align: left; margin: 0.5em auto; font-size: 1em; line-height: 1.7; color: #ccc; }
.slide li { margin-bottom: 0.3em; }
.slide code { background: rgba(255,255,255,0.1); padding: 0.15em 0.4em; border-radius: 4px; font-size: 0.9em; }
.slide pre { background: rgba(0,0,0,0.4); padding: 1em; border-radius: 8px; text-align: left; overflow-x: auto; width: 100%; max-width: 700px; }
.slide pre code { background: none; padding: 0; }
.slide strong { color: #fff; }
.controls { display: flex; justify-content: center; align-items: center; gap: 16px; padding: 10px; background: rgba(0,0,0,0.3); }
.controls button { background: rgba(255,255,255,0.15); border: none; color: #eee; width: 32px; height: 32px; border-radius: 50%; cursor: pointer; font-size: 14px; display: flex; align-items: center; justify-content: center; transition: background 0.2s; }
.controls button:hover { background: rgba(255,255,255,0.25); }
.controls button:disabled { opacity: 0.3; cursor: default; }
.controls .counter { font-size: 12px; color: #999; min-width: 50px; text-align: center; }
.notes { display: ${a?"block":"none"}; padding: 8px 16px; background: rgba(0,0,0,0.5); border-top: 1px solid rgba(255,255,255,0.1); max-height: 80px; overflow-y: auto; }
.notes-label { font-size: 9px; text-transform: uppercase; letter-spacing: 0.5px; color: #666; margin-bottom: 2px; }
.notes-text { font-size: 11px; color: #999; line-height: 1.4; white-space: pre-line; }
</style>
</head>
<body>
<div class="slide-container">
  <div class="slides">${l}</div>
  <div class="notes" id="notes"><div class="notes-label">Notes</div><div class="notes-text" id="notes-text"></div></div>
  <div class="controls">
    <button id="prev" aria-label="Previous slide">&#9664;</button>
    <span class="counter" id="counter">1 / ${n.length}</span>
    <button id="next" aria-label="Next slide">&#9654;</button>
  </div>
</div>
<script>
(function(){
  var current = 0;
  var slides = document.querySelectorAll('.slide');
  var total = slides.length;
  var counter = document.getElementById('counter');
  var prevBtn = document.getElementById('prev');
  var nextBtn = document.getElementById('next');
  var notesEl = document.getElementById('notes');
  var notesText = document.getElementById('notes-text');

  function show(idx) {
    slides.forEach(function(s, i) {
      s.classList.remove('active', 'exit-left');
      if (i < idx) s.classList.add('exit-left');
    });
    slides[idx].classList.add('active');
    counter.textContent = (idx + 1) + ' / ' + total;
    prevBtn.disabled = idx === 0;
    nextBtn.disabled = idx === total - 1;
    var notes = slides[idx].getAttribute('data-notes') || '';
    if (notes) {
      notesEl.style.display = 'block';
      notesText.textContent = notes;
    } else {
      notesEl.style.display = 'none';
    }
  }

  prevBtn.onclick = function() { if (current > 0) show(--current); };
  nextBtn.onclick = function() { if (current < total - 1) show(++current); };

  document.addEventListener('keydown', function(e) {
    if (e.key === 'ArrowLeft' && current > 0) show(--current);
    if (e.key === 'ArrowRight' && current < total - 1) show(++current);
  });

  show(0);
})();
</script>
</body>
